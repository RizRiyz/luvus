---
// Overrides Starlight's SiteTitle with the same canonical Luvus pixel mark used
// by the landing-page navigation. Sizing and type live with the rest of the
// header in styles/custom.css.
import { NAV_MARK } from '../lib/mark';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <span class="site-mark" aria-hidden="true" set:html={NAV_MARK}></span>
  <span translate="no">{siteTitle}</span>
</a>

<style is:global>
  .site-title .site-mark {
    display: block;
    flex-shrink: 0;
    /* Sized *from* the header, not independently of it. Starlight's bar is
       `--sl-nav-height` with `0.75rem` of padding each side, so this is exactly
       the space available: 40px on desktop, 32px on mobile. A fixed 42px
       overflowed both and pushed the whole header taller. */
    width: calc(var(--sl-nav-height) - 1.5rem);
    height: calc(var(--sl-nav-height) - 1.5rem);
  }
  .site-title .site-mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
