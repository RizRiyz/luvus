---
// The compact Luvus mark. Every call site across the landing pages and docs
// resolves the same SVG through here so brand updates cannot drift.
//
// Same props as before (`width` / `height` / `class`), so no call site changed.
interface Props {
  width?: number;
  height?: number;
  class?: string;
  [key: string]: unknown;
}

import logoUrl from '../assets/icons/luvus-logo.svg?url';

const { width = 32, height, class: className, ...rest } = Astro.props;
---

<img
  src={logoUrl}
  width={width}
  height={height ?? width}
  alt=""
  loading="eager"
  decoding="async"
  class:list={['bh-mark', className]}
  {...rest}
/>

<style>
  .bh-mark {
    object-fit: contain;
    display: block;
  }
</style>
