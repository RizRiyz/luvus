---
// Line icons for the feature cards on the landing page.
//
// Hand-drawn rather than pulled from a library: the page needs six glyphs, and
// an icon pack would add a dependency and a build step for that. All share one
// 24x24 grid, 1.6 stroke, round joins, and `currentColor`, so they inherit the
// accent from `.m-ic` and stay legible at 16px.
interface Props {
  name: 'remote' | 'resume' | 'board' | 'worktree' | 'keys';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'remote' && (
    <>
      {/* Two machines, linked: the local screen drives the remote one. */}
      <rect x="2.5" y="5" width="8.5" height="6.5" rx="1.4" />
      <path d="M6.75 11.5v2.2M4.9 13.7h3.7" />
      <rect x="13" y="12.5" width="8.5" height="6.5" rx="1.4" />
      <path d="M17.25 19v2.2M15.4 21.2h3.7" />
      <path d="M11.6 8.4h3.2a2 2 0 0 1 2 2v1.6" stroke-dasharray="2.2 2" />
    </>
  )}

  {name === 'resume' && (
    <>
      {/* A session picking itself back up. */}
      <path d="M3.2 12a8.8 8.8 0 1 1 2.9 6.5" />
      <path d="M3 19.4v-5h5" />
      <circle cx="12" cy="12" r="1.6" />
    </>
  )}

  {name === 'board' && (
    <>
      {/* A task board: rows with status dots, several running at once. */}
      <circle cx="4.6" cy="6.2" r="1.5" />
      <path d="M8.6 6.2h11.8" />
      <circle cx="4.6" cy="12" r="1.5" />
      <path d="M8.6 12h8.2" />
      <circle cx="4.6" cy="17.8" r="1.5" />
      <path d="M8.6 17.8h5.4" />
    </>
  )}

  {name === 'worktree' && (
    <>
      {/* git branch: a trunk with a checkout diverging off it. */}
      <circle cx="6.5" cy="4.8" r="2" />
      <circle cx="6.5" cy="19.2" r="2" />
      <circle cx="17.5" cy="12" r="2" />
      <path d="M6.5 6.8v10.4" />
      <path d="M15.5 12h-2a7 7 0 0 1-7-7" />
    </>
  )}

  {name === 'keys' && (
    <>
      {/* Sliders: remap the keys, move the panels. */}
      <path d="M3.5 7.5h11M18.5 7.5h2" />
      <circle cx="16.4" cy="7.5" r="2.1" />
      <path d="M3.5 16.5h2M9.5 16.5h11" />
      <circle cx="7.5" cy="16.5" r="2.1" />
    </>
  )}
</svg>
