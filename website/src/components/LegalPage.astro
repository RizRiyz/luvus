---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/themes.css';
import { DEFAULT_THEME } from '../lib/themes';
import Logo from './Logo.astro';
import ThemeProvider from './ThemeProvider.astro';
import XLogo from './XLogo.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}

const { title, description, path, updated } = Astro.props;
const canonical = new URL(path, 'https://luvus.dev').toString();
const GITHUB = 'https://github.com/RizRiyz/luvus';
const X = 'https://x.com/luvusdev';
---

<!doctype html>
<html lang="en" data-bh-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Luvus</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={`${title} | Luvus`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Luvus" />
    <ThemeProvider />
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a class="brand" href="/">
          <Logo width={30} height={30} aria-hidden="true" />
          <span>Luvus</span>
        </a>
        <div class="nav-links">
          <a href="/docs/">Docs</a>
          <a href="/modules/">Modules</a>
          <a href="/changelog/">Changelog</a>
          <a href={GITHUB} class="social-icon" aria-label="Luvus on GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          </a>
          <a href={X} class="social-icon" aria-label="Luvus on X" title="X"><XLogo /></a>
        </div>
      </div>
    </nav>

    <main>
      <article>
        <p class="eyebrow">Luvus</p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="updated">Last updated {updated}</p>
        <div class="rule"></div>
        <slot />
      </article>
    </main>

    <footer>
      <div class="foot-inner">
        <div class="foot-brand">
          <Logo width={22} height={22} aria-hidden="true" />
          <span>Luvus by Riz</span>
        </div>
        <div class="foot-links">
          <a href={GITHUB}>GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { color-scheme: dark; background: var(--bg); }
  :global(body) {
    margin: 0;
    min-width: 0;
    background: var(--bg);
    color: var(--text);
    font-family: InterVariable, Inter, system-ui, sans-serif;
    line-height: 1.7;
  }
  :global(a) { color: inherit; text-decoration: none; }
  nav { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 92%, transparent); }
  .nav-inner {
    width: min(1120px, calc(100% - 2.5rem));
    min-height: 68px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.65rem; font-weight: 760; font-size: 1.05rem; }
  .nav-links { display: flex; align-items: center; gap: 1.3rem; color: var(--sub); font-size: 0.9rem; }
  .social-icon {
    display: inline-flex;
    width: 33px;
    height: 33px;
    flex: 0 0 33px;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
  }
  .nav-links a:hover, .foot-links a:hover { color: var(--accent); }
  main { min-height: calc(100vh - 190px); }
  article { width: min(780px, calc(100% - 2.5rem)); margin: 0 auto; padding: 5rem 0 6rem; }
  .eyebrow {
    margin: 0 0 0.6rem;
    color: var(--accent);
    font: 600 0.78rem/1.2 'JetBrains Mono Variable', ui-monospace, monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 { margin: 0; font-size: clamp(2.4rem, 7vw, 4.4rem); line-height: 1.05; letter-spacing: -0.05em; }
  .lede { max-width: 680px; margin: 1.25rem 0 0; color: var(--sub2); font-size: 1.1rem; }
  .updated { margin: 1rem 0 0; color: var(--overlay1); font-size: 0.85rem; }
  .rule { height: 1px; margin: 2.5rem 0; background: var(--line); }
  :global(article h2) { margin: 2.7rem 0 0.75rem; font-size: 1.35rem; line-height: 1.3; }
  :global(article h3) { margin: 2rem 0 0.65rem; font-size: 1.05rem; }
  :global(article p), :global(article li) { color: var(--sub2); }
  :global(article p) { margin: 0.8rem 0; }
  :global(article ul) { margin: 0.8rem 0; padding-left: 1.3rem; }
  :global(article li + li) { margin-top: 0.55rem; }
  :global(article a) { color: var(--accent); text-decoration: underline; text-underline-offset: 0.2em; }
  :global(article code) {
    padding: 0.12rem 0.34rem;
    border: 1px solid var(--line);
    background: var(--base);
    border-radius: 0.3rem;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.88em;
  }
  footer { border-top: 1px solid var(--line); }
  .foot-inner {
    width: min(1120px, calc(100% - 2.5rem));
    margin: 0 auto;
    padding: 2rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.2rem;
    flex-wrap: wrap;
  }
  .foot-brand { display: flex; align-items: center; gap: 0.55rem; font-weight: 700; }
  .foot-links { display: flex; gap: 1.3rem; flex-wrap: wrap; color: var(--sub); font-size: 0.9rem; }
  @media (max-width: 640px) {
    .nav-inner { width: min(100% - 2rem, 1120px); min-height: 62px; }
    .nav-links { gap: 0.9rem; font-size: 0.78rem; }
    .nav-links a:nth-child(2), .nav-links a:nth-child(3) { display: none; }
    article { width: min(100% - 2rem, 780px); padding: 3.5rem 0 4.5rem; }
    .foot-inner { width: min(100% - 2rem, 1120px); flex-direction: column; gap: 1rem; text-align: center; }
    .foot-links { justify-content: center; }
  }
</style>
