---
import jetbrainsLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import plexLatin600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import '../styles/themes.css';
import { THEMES, DEFAULT_THEME } from '../lib/themes';
// The /changelog page: every release rendered as a flat, readable list.
//
// The notes come from `changelog/<tag>.md` **in the repo**, which is the same
// source `scripts/changelog.sh` publishes to the GitHub Release — so the site and
// the Releases page can never drift, the build needs no network (the GitHub API
// is rate-limited to 60 requests/hour unauthenticated), and release notes are
// reviewable in the PR that ships them. Standalone dark page matching the
// landing / compare look.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
import '@fontsource/orbit/400.css'; // the wordmark face
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import Logo from '../components/Logo.astro';
import MarketingNav from '../components/MarketingNav.astro';

const GITHUB = 'https://github.com/RizRiyz/luvus';
const RELEASES = `${GITHUB}/releases`;
const title = 'Changelog — luvus';
const description =
  'Every luvus release: new features, fixes, and changes, straight from the GitHub Releases page.';
const ogImage = 'https://luvus.dev/og.png';

// Read `changelog/*.md` from the repo at build time. `?raw` gives the file text;
// eager so it resolves during the build rather than at runtime.
const files = import.meta.glob('../../../changelog/*.md', { query: '?raw', import: 'default', eager: true });
const videoFiles = import.meta.glob('../assets/video/**/*.mp4', { query: '?url', import: 'default', eager: true });
const videos = Object.fromEntries(
  Object.entries(videoFiles).map(([path, url]) => [path.split('/').pop(), url])
);

// Website-only release media. The app, release notes, and terminal changelog
// continue to consume plain `changelog/*.md`; richer demos stay in the site.
const WEBSITE_RELEASE_MEDIA = {
  'v0.13.1': {
    heading: 'See Luvus v0.13.1 in action',
    intro:
      'Seven focused demos show the new Mission Control, localization, agent, workspace, folder, and theme workflows.',
    media: [
      {
        file: 'mission-control.mp4',
        title: 'Supervise every agent from Mission Control',
        caption:
          'Review agent state, location, model, tokens, context, and cost across the active workspace or the complete Luvus session.',
      },
      {
        file: 'cli-i18n.mp4',
        title: 'Use the CLI in your language',
        caption:
          'Read help and human-facing command output in any supported language while command syntax and machine-readable output remain stable.',
      },
      {
        file: 'i18n.mp4',
        title: 'Navigate localized Settings',
        caption:
          'Switch the interface language and use translated Settings labels, actions, hints, key references, messages, and values immediately.',
      },
      {
        file: 'grok.mp4',
        title: 'Fork a Grok Build session',
        caption:
          'Create a sibling Grok session from the current context while the original agent keeps running in its existing pane.',
      },
      {
        file: 'cwd-root.mp4',
        title: 'Open panes from the current directory',
        caption:
          'Start new tabs and splits from the focused pane directory, or retain the previous workspace-root behavior through Settings.',
      },
      {
        file: 'showhidden.mp4',
        title: 'Reveal hidden folders when you need them',
        caption:
          'Toggle hidden entries from the folder picker and jump directly to a pasted path before confirming the workspace.',
      },
      {
        file: 'theme.mp4',
        title: 'Choose new community themes',
        caption:
          'Preview and apply the latest community palettes from the same theme workflow used by built-in Luvus themes.',
      },
    ],
  },
  'v0.12.0': {
    heading: 'See Luvus v0.12.0 in action',
    intro:
      'Five focused demos show the new review, search, customization, extension, and tab organization workflows.',
    media: [
      {
        file: 'diff.mp4',
        title: 'Review changes without leaving Luvus',
        caption:
          'Inspect staged, worktree, untracked, and conflicted changes in split or stacked layouts, leave line notes, and send focused feedback to a live agent.',
      },
      {
        file: 'fuzzysearch.mp4',
        title: 'Find anything across your session',
        caption:
          'Search sessions, workspaces, tabs, panes, agents, files, and retained terminal output from one keyboard-driven fuzzy finder.',
      },
      {
        file: 'themes.mp4',
        title: 'Build themes with a live preview',
        caption:
          'Compose a palette, preview every semantic color immediately, validate it, and export a portable community theme.',
      },
      {
        file: 'bar.mp4',
        title: 'Extend the top and bottom bars',
        caption:
          'Let modules publish compact status, progress, badges, and actions beside tabs or in the bottom status row.',
      },
      {
        file: 'tabreorder.mp4',
        title: 'Put every tab exactly where you want it',
        caption:
          'Right-click a tab to rename it, move it one position, or swap it precisely with another tab.',
      },
    ],
  },
};

// Each file starts with `---\nversion: vX.Y.Z\ndate: YYYY-MM-DD\n---`. Pull those
// out and hand the rest to the Markdown renderer.
const parse = (path, text) => {
  const m = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(text);
  const meta = {};
  if (m) {
    for (const line of m[1].split(/\r?\n/)) {
      const kv = /^(\w+):\s*(.*)$/.exec(line.trim());
      if (kv) meta[kv[1]] = kv[2];
    }
  }
  const tag = meta.version || (path.split('/').pop() || '').replace(/\.md$/, '');
  return {
    tag,
    date: meta.date || '',
    body: m ? text.slice(m[0].length) : text,
    media: meta.video
      ? [{ file: meta.video, title: meta.video_title || '', caption: meta.video_caption || '' }]
      : [],
  };
};

// Releases with media keep their opening summary above the demo, then continue
// with the normal notes below it. GitHub and the terminal app still receive the
// same clean Markdown because the media configuration lives in front matter.
const splitLead = (body) => {
  const text = body.trim();
  const boundary = text.search(/\r?\n\r?\n/);
  return boundary === -1
    ? { lead: text, rest: '' }
    : { lead: text.slice(0, boundary), rest: text.slice(boundary).trim() };
};

// Contributor and issue-reporter links remain ordinary Markdown for the
// terminal app and GitHub. The website extracts the same rows into compact
// avatar cards without making a build-time API request or duplicating profile
// metadata in front matter.
const extractPeopleSection = (body, heading) => {
  const lines = body.split(/\r?\n/);
  const start = lines.findIndex((line) => line.trim() === `## ${heading}`);
  if (start === -1) return { body: body.trim(), people: [] };
  const nextHeading = lines.slice(start + 1).findIndex((line) => /^##\s+/.test(line.trim()));
  const end = nextHeading === -1 ? lines.length : start + 1 + nextHeading;
  const people = lines.slice(start + 1, end).flatMap((line) => {
    const match = /^\s*-\s+\[([^\]]+)\]\(https:\/\/github\.com\/([A-Za-z0-9-]+)\/?\)\s*$/.exec(line);
    if (!match) return [];
    const label = match[1].trim();
    const login = match[2];
    const handle = /\s+\(@[^)]+\)$/.exec(label);
    const name = handle ? label.slice(0, handle.index).trim() : label;
    const initials = name
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => Array.from(part)[0] || '')
      .join('')
      .toUpperCase();
    return [{ name, login, initials, url: `https://github.com/${login}`, avatar: `https://github.com/${login}.png?size=80` }];
  });
  const withoutSection = [...lines.slice(0, start), ...lines.slice(end)]
    .join('\n')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
  return { body: withoutSection, people };
};

const extractCredits = (body) => {
  const contributors = extractPeopleSection(body, 'Contributors');
  const reporters = extractPeopleSection(contributors.body, 'Issue reporters');
  return {
    body: reporters.body,
    contributors: contributors.people,
    reporters: reporters.people,
  };
};

// Newest first, comparing version numbers rather than strings so v0.10.0 sorts
// above v0.9.0.
const rank = (tag) =>
  tag.replace(/^v/, '').split('.').map(Number).reduce((a, n) => a * 10000 + (n || 0), 0);

const md = await createMarkdownProcessor({ gfm: true });
const fmtDate = (s) => {
  if (!s) return '';
  const d = new Date(`${s}T00:00:00Z`);
  return isNaN(+d) ? s : d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
};

const parsed = Object.entries(files)
  .map(([path, text]) => parse(path, text))
  .sort((a, b) => rank(b.tag) - rank(a.tag));

const entries = await Promise.all(
  parsed.map(async (r) => {
    const websiteMedia = WEBSITE_RELEASE_MEDIA[r.tag];
    const media = (websiteMedia?.media || r.media)
      .map((item) => ({ ...item, url: videos[item.file] || '' }))
      .filter((item) => item.url);
    const extracted = extractCredits(r.body);
    const { lead, rest } = media.length > 0
      ? splitLead(extracted.body)
      : { lead: '', rest: extracted.body };
    return {
      tag: r.tag,
      date: fmtDate(r.date),
      url: `${RELEASES}/tag/${r.tag}`,
      prerelease: false,
      media,
      mediaHeading: websiteMedia?.heading || '',
      mediaIntro: websiteMedia?.intro || '',
      contributors: extracted.contributors,
      reporters: extracted.reporters,
      leadHtml: lead ? (await md.render(lead)).code : '',
      html: (await md.render(rest || (lead ? '' : '_No release notes._'))).code,
    };
  })
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Preload the two faces that are on screen at first paint. Fontsource
         ships `font-display: swap`, so without this every navigation paints in
         the fallback mono and then reflows into the real face — the page-wide
         blink. Preloading lets the font arrive before that first paint, so the
         swap is never seen. Only the latin subsets, and only the weights the
         chrome actually uses. -->
    <link rel="preload" href={jetbrainsLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexLatin600} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://luvus.dev/changelog/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://luvus.dev/changelog/" />
    <meta property="og:site_name" content="luvus" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Apply the saved palette *before first paint*. Astro defers normal
         <script> tags, so the picker's own script at the end of <body> only runs
         after the page has already painted in the default palette — which is the
         noir flash you see on every navigation. `is:inline` keeps this as a
         plain blocking script in <head>, so the first paint is already correct.
         Deliberately tiny and dependency-free; it must not delay rendering. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('luvus-theme');
        if (t) document.documentElement.setAttribute('data-bh-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <MarketingNav active="changelog" />

    <div class="page-frame">

    <header class="page-hero">
      <div class="glow" aria-hidden="true"></div>
      <span class="eyebrow">Changelog</span>
      <h1>What's new in luvus</h1>
      <p>
        Every release from new features, fixes, and changes pulled straight from GitHub, newest
        first.
      </p>
      <div class="hero-cta">
        <a class="btn" href={RELEASES}>All releases on GitHub →</a>
      </div>
    </header>

    <section class="log">
      {
        entries.length === 0 ? (
          <div class="empty">
            <p>The full release history lives on GitHub.</p>
            <a class="btn primary" href={RELEASES}>
              View releases →
            </a>
          </div>
        ) : (
          <ol class="release-list">
            {entries.map((e, i) => (
              <li class="entry">
                <article class="release">
                  <div class="chead">
                    <a class="version" href={e.url}>
                      {e.tag}
                    </a>
                    {i === 0 && !e.prerelease && <span class="badge latest">Latest</span>}
                    {e.prerelease && <span class="badge pre">Pre-release</span>}
                    <time class="date">{e.date}</time>
                  </div>
                  {e.leadHtml && <div class="notes release-lead" set:html={e.leadHtml} />}
                  {e.media.length > 0 && (
                    <div class="release-showcase">
                      {(e.mediaHeading || e.mediaIntro) && (
                        <div class="release-showcase-intro">
                          {e.mediaHeading && <h2>{e.mediaHeading}</h2>}
                          {e.mediaIntro && <p>{e.mediaIntro}</p>}
                        </div>
                      )}
                      <div class="release-media-slider" data-changelog-slider>
                        <div class="release-media-viewport">
                          {e.media.map((media, mediaIndex) => (
                            <figure
                              class="release-media"
                              data-changelog-slide
                              hidden={mediaIndex !== 0}
                            >
                            <video
                              class="release-video"
                              data-changelog-video
                              muted
                              loop
                              playsinline
                              controls
                              preload="metadata"
                              aria-label={media.title || `Demo for ${e.tag}`}
                            >
                              <source src={media.url} type="video/mp4" />
                              Your browser cannot play this video. <a href={media.url}>Open the demo</a>.
                            </video>
                            {(media.title || media.caption) && (
                              <figcaption>
                                {media.title && <strong>{media.title}</strong>}
                                {media.caption && <span>{media.caption}</span>}
                              </figcaption>
                            )}
                            </figure>
                          ))}
                        </div>
                        {e.media.length > 1 && (
                          <div class="release-media-controls" aria-label={`Demo navigation for ${e.tag}`}>
                            <button type="button" data-changelog-prev aria-label="Previous demo">
                              <span aria-hidden="true">←</span> Previous
                            </button>
                            <span class="release-media-count" data-changelog-count aria-live="polite">
                              1 / {e.media.length}
                            </span>
                            <button type="button" data-changelog-next aria-label="Next demo">
                              Next <span aria-hidden="true">→</span>
                            </button>
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                  <div class="notes" set:html={e.html} />
                  {[
                    { key: 'contributors', title: 'Contributors', people: e.contributors },
                    { key: 'issue-reporters', title: 'Issue reporters', people: e.reporters },
                  ].filter((group) => group.people.length > 0).map((group) => (
                    <div class="release-contributors" aria-labelledby={`${group.key}-${e.tag}`}>
                      <h2 id={`${group.key}-${e.tag}`}>{group.title}</h2>
                      <ul>
                        {group.people.map((person) => (
                          <li>
                            <a href={person.url} title={`View ${person.name} on GitHub`}>
                              <span class="contributor-avatar" aria-hidden="true">
                                <span>{person.initials}</span>
                                <img
                                  src={person.avatar}
                                  alt=""
                                  width="40"
                                  height="40"
                                  loading="lazy"
                                  decoding="async"
                                  referrerpolicy="no-referrer"
                                  data-contributor-avatar
                                />
                              </span>
                              <span class="contributor-name">
                                <strong>{person.name}</strong>
                                {person.name !== person.login && <small>@{person.login}</small>}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </article>
              </li>
            ))}
          </ol>
        )
      }
    </section>

    </div>

    <footer>
      <div class="foot-inner">
        <div class="foot-brand">
          <Logo width={22} height={22} class="mark" aria-hidden="true" />
          <span>Luvus</span>
          <span class="dim">by Riz</span>
        </div>
        <div class="foot-links">
          <a href={GITHUB}>GitHub</a>
          <a href="https://crates.io/crates/luvus">crates.io</a>
        </div>
      </div>
    </footer>

    <!-- Theme picker · floating dock, deliberately outside the nav. A custom
         listbox (not a native select) so it matches the site, opens upward, and
         previews each palette live on hover. -->
    <!-- Brand context menu · right-click the wordmark for the logo assets, the
         way most product sites expose their mark. Plain links + clipboard, no
         dependency. -->
    <div class="brandmenu" id="brandmenu" hidden>
      <a class="bm-item" id="bm-png" href="/brand/luvus-logo.png" download="luvus-logo.png">Download PNG</a>
      <a class="bm-item" id="bm-svg" href="/brand/luvus-logo.svg" download="luvus-logo.svg">Download SVG</a>
      <button type="button" class="bm-item" id="bm-copy" data-src="/brand/luvus-logo.svg">Copy SVG</button>
    </div>
    <div class="theme-dock" id="theme-dock">
      <ul class="td-list" id="td-list" role="listbox" aria-label="Color theme" hidden>
        {THEMES.map((t) => (
          <li>
            <button type="button" class="td-opt" role="option" data-theme={t.id}>
              <i class="td-sw" data-theme={t.id} aria-hidden="true"></i>
              <span class="td-name">{t.label}</span>
            </button>
          </li>
        ))}
      </ul>
      <button type="button" class="td-btn" id="td-btn" aria-expanded="false" aria-haspopup="listbox">
        <i class="td-sw td-sw-cur" aria-hidden="true"></i>
        <span id="td-cur">{THEMES.find((t) => t.id === DEFAULT_THEME)?.label ?? DEFAULT_THEME}</span>
        <span class="td-caret" aria-hidden="true">▴</span>
      </button>
    </div>
    <script>
      // A release can have several demos, but only the visible slide should
      // decode and play. People who request reduced motion start playback
      // themselves through the native video controls.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelectorAll('[data-changelog-slider]').forEach((slider) => {
        if (!(slider instanceof HTMLElement)) return;
        const slides = Array.from(slider.querySelectorAll('[data-changelog-slide]'));
        const counter = slider.querySelector('[data-changelog-count]');
        const previous = slider.querySelector('[data-changelog-prev]');
        const next = slider.querySelector('[data-changelog-next]');
        let active = 0;

        const show = (index) => {
          active = (index + slides.length) % slides.length;
          slides.forEach((slide, slideIndex) => {
            if (!(slide instanceof HTMLElement)) return;
            const visible = slideIndex === active;
            slide.hidden = !visible;
            const video = slide.querySelector('video');
            if (!(video instanceof HTMLVideoElement)) return;
            if (!visible) {
              video.pause();
              video.currentTime = 0;
            } else if (!reduceMotion) {
              void video.play().catch(() => {});
            }
          });
          if (counter) counter.textContent = `${active + 1} / ${slides.length}`;
        };

        previous?.addEventListener('click', () => show(active - 1));
        next?.addEventListener('click', () => show(active + 1));
        show(0);
      });
      document.querySelectorAll('[data-contributor-avatar]').forEach((avatar) => {
        if (!(avatar instanceof HTMLImageElement)) return;
        avatar.addEventListener('error', () => { avatar.hidden = true; }, { once: true });
      });
    </script>

    <style is:global>
      :root {
    --bg: #242933;
    --bg2: #2e3440;
    --base: #3b4252;
    --surface: #292f3a;
    --line: #434c5e;
    --border: #434c5e;
    --overlay0: #4c566a;
    --overlay1: #616e88;
    --sub: #b0b8c8;
    --sub2: #d8dee9;
    --text: #eceff4;
    --accent: #88c0d0;
    --sel: #3b4a5e;
    --green: #a3be8c;
    --mint: #8fbcbb;
    --amber: #ebcb8b;
    --coral: #bf616a;
      }
      * { box-sizing: border-box; margin: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg); color: var(--text);
        font: 15px/1.75 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
      }
      a { color: inherit; text-decoration: none; }
      h2 { font-size: 1.45rem; letter-spacing: -0.035em; }

      h1, h2, h3, .brand, .foot-brand {
        font-family: 'IBM Plex Mono', ui-monospace, 'JetBrains Mono Variable', monospace;
        line-height: 1.14; letter-spacing: -0.045em;
      }
      /* Same shell as the landing page: hairline rules down the content's
         edges, sections running the frame's full width and dividing with a
         rule, and the nav/footer outside so their horizontal rules reach the
         viewport edges. */
      :root { --gut: 2.6rem; }
      @media (max-width: 900px) { :root { --gut: 1.6rem; } }
      @media (max-width: 560px) { :root { --gut: 1.15rem; } }
      .page-frame {
        max-width: 1440px; margin: 0 auto; background: var(--bg); position: relative;
        border-inline: 1px solid var(--line);
      }
      .page-frame > section:last-child { border-bottom: 0; }
      section, header.page-hero {
        max-width: none; margin: 0; padding: 4rem var(--gut);
        border-bottom: 1px solid var(--line);
      }
      .dim { color: var(--sub); }
      ::selection { background: var(--sel); color: var(--text); }

      .mark { display: block; flex-shrink: 0; }

      /* hero */
      .page-hero { text-align: center; position: relative; padding-top: 4.5rem; padding-bottom: 1.5rem; }
      .page-hero .glow { display: none;
        position: absolute; inset: -20% 0 auto 0; height: 460px; pointer-events: none;
        background: radial-gradient(ellipse 60% 55% at 50% 0%, rgb(from var(--accent) r g b / 0.09), transparent 70%);
      }
      .eyebrow { font-family: 'IBM Plex Mono', monospace; color: var(--accent); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; position: relative; }
      .page-hero h1 { font-size: clamp(1.9rem, 4.6vw, 2.8rem); font-weight: 600; letter-spacing: -0.045em; margin-top: 0.6rem; position: relative; }
      .page-hero p { color: var(--sub); max-width: 46rem; margin: 1.1rem auto 0; font-size: 0.9rem; line-height: 1.8; position: relative; }
      .hero-cta { margin-top: 1.6rem; position: relative; }

      .btn {
        display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.35rem;
         border: 1px solid var(--line); font-weight: 600; font-size: 0.92rem;
        font-family: 'IBM Plex Mono', monospace; transition: border-color 0.15s, transform 0.15s, filter 0.15s;
      }
      .btn:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent); }
      .btn.primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
      .btn.primary:hover { filter: brightness(1.08); color: var(--bg); }

      /* Flat release list. The page gutters are the only horizontal chrome, so
         notes keep their useful width on phones without becoming too long to
         scan on a desktop. */
      .log { max-width: 64rem; margin-inline: auto; padding-top: 1rem; }
      .empty { text-align: center; color: var(--sub); display: grid; gap: 1.2rem; justify-items: center; padding: 3rem 0; }
      .release-list { list-style: none; padding: 0; margin: 0; }
      .entry { border-bottom: 1px solid var(--line); }
      .entry:last-child { border-bottom: 0; }
      .release { min-width: 0; padding: 1.6rem 0 1.8rem; }
      .chead { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 0.35rem; }
      .version {
        font-family: 'IBM Plex Mono', monospace; font-weight: 700; font-size: 1.12rem;
        color: var(--accent); letter-spacing: -0.02em;
      }
      .version:hover { text-decoration: underline; }
      .badge {
        font-family: 'IBM Plex Mono', monospace; font-size: 0.6rem; text-transform: uppercase;
        letter-spacing: 0.09em; padding: 0.18rem 0.5rem;  line-height: 1;
      }
      .badge.latest { background: var(--accent); color: var(--bg); font-weight: 700; }
      .badge.pre { border: 1px solid var(--amber); color: var(--amber); }
      .date {
        margin-left: auto; color: var(--sub); font-size: 0.8rem;
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
      }

      /* rendered release notes */
      .notes { color: var(--text); font-size: 0.95rem; min-width: 0; }
      /* Long code lines scroll inside their block instead of widening the page. */
      .notes pre { max-width: 100%; }
      .notes code { overflow-wrap: break-word; }
      .notes a { overflow-wrap: break-word; }
      .notes > :first-child { margin-top: 0.35rem; }
      .notes > :last-child { margin-bottom: 0; }
      .notes h1, .notes h2, .notes h3, .notes h4, .notes h5 {
        font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 0.76rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.09em; color: var(--sub);
        margin: 1.35rem 0 0.6rem;
      }
      .notes p { color: var(--sub); margin: 0.5rem 0; line-height: 1.6; }
      .notes strong { color: var(--text); font-weight: 600; }
      .notes ul, .notes ol { list-style: none; padding: 0; margin: 0.35rem 0; }
      .notes li {
        position: relative; padding-left: 1.3rem; margin: 0.42rem 0; color: var(--sub);
        line-height: 1.58;
      }
      .notes li::before {
        content: ''; position: absolute; left: 0.2rem; top: 0.62em; width: 5px; height: 5px;
        border-radius: 50%; background: var(--accent); opacity: 0.85;
      }
      .notes li strong { color: var(--text); }
      .notes a {
        color: var(--accent); border-bottom: 1px solid rgb(from var(--accent) r g b / 0.28);
        transition: border-color 0.15s;
      }
      .notes a:hover { border-bottom-color: var(--accent); }
      .notes code {
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace; font-size: 0.86em;
        color: var(--accent); background: rgb(from var(--accent) r g b / 0.07);
        border: 1px solid rgb(from var(--accent) r g b / 0.14); padding: 0.05rem 0.35rem;
      }
      .notes pre {
        background: var(--bg); border: 1px solid var(--line);
        padding: 0.9rem 1rem; overflow-x: auto; margin: 0.7rem 0;
      }
      .notes pre code { background: none; border: none; padding: 0; color: var(--text); font-size: 0.85em; }
      .notes hr { border: none; border-top: 1px solid var(--line); margin: 1.1rem 0; }
      .notes blockquote {
        border-left: 2px solid var(--line); padding-left: 0.9rem; margin: 0.6rem 0; color: var(--sub);
      }
      .release-contributors { margin-top: 1.35rem; }
      .release-contributors h2 {
        color: var(--sub); font: 700 0.76rem/1.2 'IBM Plex Mono', ui-monospace, monospace;
        text-transform: uppercase; letter-spacing: 0.09em; margin-bottom: 0.7rem;
      }
      .release-contributors ul {
        display: flex; flex-wrap: wrap; gap: 0.55rem; list-style: none; padding: 0; margin: 0;
      }
      .release-contributors li { min-width: 0; max-width: 100%; }
      .release-contributors a {
        display: flex; align-items: center; gap: 0.55rem; min-height: 48px;
        max-width: 100%;
        padding: 0.28rem 0.62rem 0.28rem 0.28rem; border: 1px solid var(--line);
        background: var(--surface); transition: border-color 0.15s, color 0.15s;
      }
      .release-contributors a:hover, .release-contributors a:focus-visible {
        border-color: var(--accent); color: var(--accent); outline: none;
      }
      .contributor-avatar {
        position: relative; display: grid; place-items: center; flex: 0 0 40px;
        width: 40px; height: 40px; overflow: hidden; border: 1px solid var(--line);
        background: var(--base); color: var(--sub2);
        font: 700 0.72rem/1 'IBM Plex Mono', ui-monospace, monospace;
      }
      .contributor-avatar img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
      .contributor-avatar img[hidden] { display: none; }
      .contributor-name { display: grid; min-width: 0; overflow: hidden; line-height: 1.25; }
      .contributor-name strong, .contributor-name small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .contributor-name strong { color: var(--text); font-size: 0.78rem; font-weight: 600; }
      .contributor-name small { color: var(--sub); font: 0.66rem/1.3 'JetBrains Mono Variable', ui-monospace, monospace; }
      .release-lead > :last-child { margin-bottom: 1rem; }
      .release-showcase { margin: 1rem 0 1.5rem; }
      .release-showcase-intro { margin-bottom: 0.9rem; }
      .release-showcase-intro h2 {
        color: var(--text); font-size: 1rem; letter-spacing: -0.02em;
      }
      .release-showcase-intro p {
        color: var(--sub); font-size: 0.9rem; line-height: 1.6; margin-top: 0.35rem;
      }
      .release-media-slider { min-width: 0; }
      .release-media-viewport { min-width: 0; }
      .release-media { margin: 0; }
      .release-media[hidden] { display: none; }
      .release-video {
        display: block; width: 100%; height: auto; max-height: min(76vh, 820px);
        background: var(--bg); border: 1px solid var(--line); object-fit: contain;
      }
      .release-media figcaption {
        display: grid; gap: 0.25rem; padding: 0.75rem 0.9rem;
        border: 1px solid var(--line); border-top: 0;
        color: var(--sub); font-size: 0.82rem; line-height: 1.55;
      }
      .release-media figcaption strong {
        color: var(--text); font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 0.84rem;
      }
      .release-media-controls {
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
        gap: 0.75rem; margin-top: 0.65rem;
      }
      .release-media-controls button {
        width: fit-content; border: 1px solid var(--line); background: var(--surface);
        color: var(--sub2); padding: 0.48rem 0.72rem; cursor: pointer;
        font: 600 0.76rem/1.2 'JetBrains Mono Variable', ui-monospace, monospace;
      }
      .release-media-controls button:last-child { justify-self: end; }
      .release-media-controls button:hover,
      .release-media-controls button:focus-visible {
        border-color: var(--accent); color: var(--accent); outline: none;
      }
      .release-media-count {
        color: var(--sub); font: 0.76rem/1.2 'JetBrains Mono Variable', ui-monospace, monospace;
      }

      /* footer */
      footer { border-top: 1px solid var(--line); margin-top: 0; }
      .foot-inner {
        max-width: 1440px; margin: 0 auto; padding: 2rem var(--gut);
        display: flex; justify-content: center; align-items: center; gap: 2.2rem; flex-wrap: wrap;
      }
      .foot-brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
      .foot-brand .dim { font-weight: 400; font-size: 0.85rem; }
      .foot-links { display: flex; gap: 1.3rem; color: var(--sub); font-size: 0.92rem; flex-wrap: wrap; }
      .foot-links a:hover { color: var(--accent); }

      @media (max-width: 760px) {
        section, header.page-hero { padding: 3rem 1.25rem; }
        .log { padding-top: 0.5rem; padding-inline: 1rem; }
        .release { padding-block: 1.35rem 1.55rem; }
      }

      /* Brand context menu (right-click the wordmark). Same square, hairline
         language as the theme dock. */
      .brandmenu {
        position: fixed; z-index: 60; min-width: 158px; padding: 0.25rem;
        background: rgb(from var(--bg2) r g b / 0.98);
        border: 1px solid var(--line);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      }
      .brandmenu[hidden] { display: none; }
      .bm-item {
        display: block; width: 100%; padding: 0.3rem 0.6rem;
        background: none; border: 0; text-align: left; cursor: pointer;
        color: var(--sub); font: inherit; font-size: 0.76rem; white-space: nowrap;
      }
      .bm-item:hover, .bm-item:focus-visible {
        background: rgb(from var(--accent) r g b / 0.14); color: var(--text); outline: none;
      }
      /* Theme picker · floating dock, bottom-right, opening upward. Names only:
         descriptions wrapped and forced scrollbars, and the list is short enough
         to show all palettes at once, so there is nothing to scroll. Hovering a
         name previews that palette on the page immediately. */
      .theme-dock { position: fixed; z-index: 40; right: 1.1rem; bottom: 1.1rem; }
      .td-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.42rem 0.7rem; cursor: pointer;
        background: rgb(from var(--bg2) r g b / 0.94);
        border: 1px solid var(--line); color: var(--text);
        font: inherit; font-size: 0.78rem;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        transition: border-color 0.15s;
      }
      .td-btn:hover, .td-btn[aria-expanded='true'] { border-color: var(--accent); }
      .td-caret { color: var(--sub); font-size: 0.6rem; transition: transform 0.18s; }
      .td-btn[aria-expanded='true'] .td-caret { transform: rotate(180deg); }
      .td-sw {
        width: 9px; height: 9px; flex-shrink: 0; display: block;
        background: var(--accent); border: 1px solid rgb(from var(--text) r g b / 0.25);
      }
      /* Grows upward from the button. No max-height and no overflow, so every
         palette is visible and no scrollbar ever appears. */
      .td-list {
        position: absolute; bottom: 100%; right: 0; margin-bottom: -1px;
        margin: 0; padding: 0.3rem; list-style: none;
        background: rgb(from var(--bg2) r g b / 0.98);
        border: 1px solid var(--line);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      }
      .td-list[hidden] { display: none; }
      .td-opt {
        display: flex; align-items: center; gap: 0.6rem; width: 100%;
        padding: 0.26rem 0.75rem 0.26rem 0.5rem; cursor: pointer;
        background: none; border: 0; text-align: left;
        color: var(--sub); font: inherit; font-size: 0.78rem;
        white-space: nowrap;
      }
      .td-opt:hover, .td-opt:focus-visible { background: rgb(from var(--accent) r g b / 0.14); color: var(--text); outline: none; }
      .td-opt[aria-selected='true'] { color: var(--accent); }
    </style>

    <script>
      // Theme picker · palettes come from luvus's own registry, generated into
      // styles/themes.css, so what you preview is what the app ships. Applying a
      // theme sets `data-bh-theme` on <html>, which outranks each page's :root.
      //
      // Hovering a name previews it immediately; the choice is only committed on
      // click, so moving away or closing restores what you had.
      import { DEFAULT_THEME } from '../lib/themes';
      (() => {
        const KEY = 'luvus-theme';
        const dock = document.getElementById('theme-dock');
        const btn = document.getElementById('td-btn');
        const list = document.getElementById('td-list');
        const label = document.getElementById('td-cur');
        if (!dock || !btn || !list || !label) return;
        const opts = [...list.querySelectorAll('.td-opt')];
        const root = document.documentElement;

        let committed = localStorage.getItem(KEY) || DEFAULT_THEME;

        // Preview only: paints the page without touching the committed choice.
        const paint = (id) => root.setAttribute('data-bh-theme', id);

        const commit = (id) => {
          committed = id;
          localStorage.setItem(KEY, id);
          paint(id);
          const o = opts.find((x) => x.dataset.theme === id);
          label.textContent = o ? o.querySelector('.td-name').textContent : id;
          opts.forEach((x) => x.setAttribute('aria-selected', String(x.dataset.theme === id)));
        };

        // Set once the arrow keys take over, so pointer and keyboard previews
        // don't fight over which one wins when the pointer leaves the list.
        let kbdNav = false;

        const open = (yes) => {
          kbdNav = false;
          list.hidden = !yes;
          btn.setAttribute('aria-expanded', String(yes));
          if (yes) (opts.find((o) => o.getAttribute('aria-selected') === 'true') || opts[0])?.focus();
          else paint(committed); // closing always restores the committed palette
        };


        commit(committed);

        btn.addEventListener('click', () => open(list.hidden));
        opts.forEach((o) => {
          // Live preview on hover and on keyboard focus.
          o.addEventListener('mouseenter', () => paint(o.dataset.theme));
          o.addEventListener('focus', () => paint(o.dataset.theme));
          o.addEventListener('click', () => {
            commit(o.dataset.theme);
            open(false);
            btn.focus();
          });
        });
        // Leaving the list without choosing puts the committed palette back —
        // unless the keyboard is driving, in which case the focused row is the
        // preview and the pointer wandering off must not cancel it. Opening the
        // list focuses a row, so testing `activeElement` alone would treat every
        // mouse-opened list as keyboard-driven and leave the preview stuck on
        // whatever was hovered last.
        list.addEventListener('mouseleave', () => {
          if (list.hidden) return;
          const act = document.activeElement;
          const focused = kbdNav && act instanceof HTMLElement ? act.dataset.theme : null;
          paint(focused || committed);
        });
        document.addEventListener('click', (e) => {
          if (!dock.contains(e.target)) open(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !list.hidden) { open(false); btn.focus(); }
        });
        list.addEventListener('keydown', (e) => {
          const i = opts.indexOf(document.activeElement);
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            kbdNav = true;
            const next = e.key === 'ArrowDown' ? i + 1 : i - 1;
            opts[(next + opts.length) % opts.length].focus();
          }
        });
      })();
    </script>

    <script>
      // Right-click the wordmark for the brand assets. Downloads are plain
      // `download` links; the copy reads the built SVG and writes the markup to
      // the clipboard so it can be pasted straight into a design tool.
      (() => {
        const brand = document.querySelector('[data-site-nav-brand]');
        const menu = document.getElementById('brandmenu');
        const copy = document.getElementById('bm-copy');
        if (!brand || !menu) return;

        const close = () => { menu.hidden = true; };

        brand.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          menu.hidden = false;
          // Place at the cursor, then nudge back inside the viewport.
          const r = menu.getBoundingClientRect();
          const x = Math.min(e.clientX, window.innerWidth - r.width - 8);
          const y = Math.min(e.clientY, window.innerHeight - r.height - 8);
          menu.style.left = `${Math.max(8, x)}px`;
          menu.style.top = `${Math.max(8, y)}px`;
        });

        copy?.addEventListener('click', async () => {
          const label = copy.textContent;
          try {
            const svg = await fetch(copy.dataset.src).then((r) => r.text());
            await navigator.clipboard.writeText(svg);
            copy.textContent = 'Copied';
          } catch {
            copy.textContent = 'Copy failed';
          }
          setTimeout(() => {
            copy.textContent = label;
            close();
          }, 900);
        });

        // Downloads can close immediately; the browser handles the rest.
        menu.querySelectorAll('a.bm-item').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('click', (e) => { if (!menu.contains(e.target)) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        window.addEventListener('blur', close);
      })();
    </script>
  </body>
</html>
