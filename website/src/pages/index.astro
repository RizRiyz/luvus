---
import jetbrainsLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import plexLatin600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import '../styles/themes.css';
import { THEMES, DEFAULT_THEME } from '../lib/themes';
// The luvus product homepage — a custom landing page, independent of the
// Starlight docs layout (docs live under /docs/…). Dark-first, the app's own
// terminal-native aesthetic. The palette is switchable: every colour comes
// from tokens in styles/themes.css, generated from the app's own registry.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
import '@fontsource/orbit/400.css'; // the wordmark face
import Logo from '../components/Logo.astro';
import XLogo from '../components/XLogo.astro';
// The surviving Luvus mark. Imported raw and retinted at build time so it can be a
// theme-aware line drawing rather than a flat image:
//   * the white backing rect goes, or it would be a white square on a dark page;
//   * `#272727` becomes `currentColor`, so CSS decides the ink;
//   * the `white` knockout fills (they hide the antennae behind the circles)
//     become `var(--bg)`, so they still occlude but match whatever the page is.
import luvusRaw from '../assets/luvus-logo.svg?raw';
const luvusTinted = luvusRaw
  .replace(/<rect width="1000" height="1000" fill="white"\/>/, '')
  .replace(/#272727/g, 'currentColor')
  .replace(/fill="white"/g, 'fill="var(--bg)"');
// Split the puppet into the three parts that hang, so each can swing on its own
// string instead of the whole mark moving as one rigid piece. The artwork is a
// flat list of 16 shapes in a fixed order:
//   0-1 crossbar · 2 neck · 3-4 strings · 5 head + 6-7 eyes ·
//   8 left ball + 9-11 its marks · 12 right ball + 13-15 its marks
// Guarded on that count: if the artwork is re-exported differently the grouping
// is skipped and the mark still renders, just swinging as a whole.
const luvusParts = luvusTinted.match(/<(?:rect|circle)[^>]*\/>/g) ?? [];
// Rebuilt between the <svg> tags rather than by substituting the joined shapes:
// the source keeps one element per line, so a join with no separator matches
// nothing and the grouping silently does not happen.
const luvusSvg =
  luvusParts.length === 16
    ? luvusTinted.replace(
        /(<svg[^>]*>)[\s\S]*(<\/svg>)/,
        (_m: string, open: string, close: string) =>
          open +
          luvusParts.slice(0, 5).join('') +
          `<g class="p-head">${luvusParts.slice(5, 8).join('')}</g>` +
          `<g class="p-left">${luvusParts.slice(8, 12).join('')}</g>` +
          `<g class="p-right">${luvusParts.slice(12, 16).join('')}</g>` +
          close
      )
    : luvusTinted;
import { NAV_MARK } from '../lib/mark';
import FeatureIcon from '../components/FeatureIcon.astro';
// Authentic brand marks (24×24 SVGs) for the "works with" grid. The `-color`
// ones carry their own fills; the rest are `currentColor` (recolored via CSS,
// flagged `mono`). `hook` marks agents that get native session resume (a dot in
// the grid); most of them also report precise events via the optional hook.
import IconClaudeCode from '../assets/icons/claudecode-color.svg';
import IconCopilot from '../assets/icons/githubcopilot.svg';
import IconCodex from '../assets/icons/codex-color.svg';
import IconOpencode from '../assets/icons/opencode.svg';
import IconCursor from '../assets/icons/cursor.svg';
import IconKimi from '../assets/icons/kimi-color.svg';
import IconAmp from '../assets/icons/amp-color.svg';
import IconGrok from '../assets/icons/grok.svg';
import IconPi from '../assets/icons/pi.svg';
import IconQwen from '../assets/icons/qwen-color.svg';
import IconGemini from '../assets/icons/geminicli-color.svg';
import IconKiro from '../assets/icons/kiro-color.svg';
import IconAider from '../assets/icons/aider.svg';
// Droid's logo only exists as a raster. Its alpha channel is used as a CSS mask
// so the mark still inherits `currentColor` like the inline SVGs do.
import droidMask from '../assets/icons/droid-mask.png';

const GITHUB = 'https://github.com/RizRiyz/luvus';
const X = 'https://x.com/luvusdev';

// Every agent in `detect::KNOWN_AGENTS` (14), which CLAUDE.md requires this
// grid to stay truthful to. `aider` and `droid` have no icon in assets/icons,
// so they render a lettermark rather than being left out of the list.
const AGENTS = [
  { name: 'Claude Code', Icon: IconClaudeCode, hook: true },
  { name: 'Codex', Icon: IconCodex, hook: true },
  { name: 'Gemini', Icon: IconGemini },
  { name: 'Aider', Icon: IconAider },
  { name: 'opencode', Icon: IconOpencode, mono: true, hook: true },
  { name: 'Copilot', Icon: IconCopilot, mono: true, hook: true },
  { name: 'Kimi', Icon: IconKimi, hook: true },
  { name: 'Qwen', Icon: IconQwen },
  { name: 'Kiro', Icon: IconKiro },
  { name: 'Cursor', Icon: IconCursor, mono: true },
  { name: 'Amp', Icon: IconAmp },
  { name: 'Droid', mask: droidMask.src },
  { name: 'Grok', Icon: IconGrok, mono: true, hook: true },
  { name: 'Pi', Icon: IconPi, mono: true, hook: true },
];

const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);

const title = 'luvus: mission control for your AI coding agents';
const description =
  'Mission control for your AI coding agents. Run, watch, resume, and orchestrate Claude Code, Codex, Copilot, opencode and more from one terminal, with a live view of every agent.';
const ogImage = 'https://luvus.dev/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Preload the two faces that are on screen at first paint. Fontsource
         ships `font-display: swap`, so without this every navigation paints in
         the fallback mono and then reflows into the real face — the page-wide
         blink. Preloading lets the font arrive before that first paint, so the
         swap is never seen. Only the latin subsets, and only the weights the
         chrome actually uses. -->
    <link rel="preload" href={jetbrainsLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexLatin600} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://luvus.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://luvus.dev/" />
    <meta property="og:site_name" content="luvus" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Apply the saved palette *before first paint*. Astro defers normal
         <script> tags, so the picker's own script at the end of <body> only runs
         after the page has already painted in the default palette — which is the
         noir flash you see on every navigation. `is:inline` keeps this as a
         plain blocking script in <head>, so the first paint is already correct.
         Deliberately tiny and dependency-free; it must not delay rendering. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('luvus-theme');
        if (t) document.documentElement.setAttribute('data-bh-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
      <a class="brand" href="/">
        <!-- Canonical Luvus mark, retinted with the active theme. -->
        <span class="mark mark-luvus" aria-hidden="true" set:html={NAV_MARK}></span>
        <span>Luvus</span>
      </a>
      <div class="nav-links">
        <a href="/docs/">Docs</a>
        <a href="/modules/">Modules</a>
        <a href="/themes/">Themes</a>
        <a href="/changelog/">Changelog</a>
        <a href={GITHUB} class="gh" aria-label="luvus on GitHub" title="GitHub">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path></svg
          >
        </a>
        <a href={X} class="gh" aria-label="Luvus on X" title="X"><XLogo /></a>
      </div>
      </div>
    </nav>

    <div class="page-frame">

    <header class="hero">
      <div class="glow" aria-hidden="true"></div>

      <div class="hero-top">
        <div class="hero-copy">
          <h1>Next-Gen mission control<br /><span class="accent">for your AI agents</span></h1>
          <p class="sub">
            One place to run, watch, resume, and orchestrate every coding agent.
          </p>

          <div class="install" id="install">
            <code>curl -fsSL https://luvus.dev/install.sh | sh</code>
            <button id="copy" aria-label="Copy install command" title="Copy">⧉</button>
          </div>
          <p class="alt-install">
            or <code>brew install RizRiyz/luvus/luvus</code> ·
            <a href="/docs/getting-started/installation/">Windows &amp; more</a>
          </p>
        </div>

        <div class="hero-art hero-art-svg" aria-hidden="true" set:html={luvusSvg}></div>
      </div>

      <!-- Live, clickable simulation of the real UI, not a screenshot. -->
      <div class="demo" id="demo">
        <div class="demo-chrome">
          <span class="tl r"></span><span class="tl y"></span><span class="tl g"></span>
          <span class="demo-title">luvus · sudos</span>
          <span class="demo-hint">● live demo · click around</span>
        </div>
        <div class="demo-body">
          <aside class="demo-side">
            <div class="side-brand">
              <Logo width={16} height={16} class="mark" aria-hidden="true" />
              <span class="side-name">luvus</span>
              <span class="side-ver">v0.7</span>
              <button class="menu-pill" id="menu-pill" title="Settings · theme · keys · language">Menu</button>
            </div>
            <div class="side-dock">
            <div class="side-label">Workspaces</div>
            <button class="ws on" data-ws="sudos">
              <span class="ws-arrow">▾</span> sudos <span class="branch">⎇ main</span><span class="ab">↑2</span>
            </button>
            <button class="ws" data-ws="webapp">
              <span class="ws-arrow">▸</span> webapp <span class="branch">⎇ feat/ui</span>
            </button>
            </div>
            <div class="side-dock">
            <div class="side-label agents-label">
              <span>Agents</span>
              <span class="afilter">
                <button class="fchip" data-f="all">All</button><button class="fchip on" data-f="active">Active</button>
              </span>
            </div>
            <button class="agent focused" data-agent="claude">
              <span class="dot working" id="dot-claude"></span>claude<span class="proj">sudos</span>
            </button>
            <button class="agent" data-agent="copilot">
              <span class="dot blocked" id="dot-copilot"></span>copilot<span class="proj">webapp</span>
            </button>
            <button class="agent" data-agent="codex">
              <span class="dot done" id="dot-codex"></span>codex<span class="proj">sudos</span>
            </button>
            <button class="session-row" id="session-row" hidden>
              <span class="c-dim">↺</span> claude <span class="proj">2h ago · api</span>
            </button>
            </div>
          </aside>
          <div class="demo-main">
            <div class="demo-tabs">
              <button class="tab on" data-tab="main">1 main</button>
              <button class="tab" data-tab="git">2 ⎇ git</button>
              <button class="tab" data-tab="orch">3 ◇ orch</button>
              <button class="tab" data-tab="ctrl">4 ⦿ ctrl</button>
              <button class="tab" data-tab="talk">5 ⇄ talk</button>
              <span class="tab plus">+</span>
            </div>

            <div class="demo-view" id="view-main">
              <div class="demo-panes" id="ws-sudos">
                <div class="pane focused" id="pane-left" data-agent="claude">
                  <div class="pane-title" id="left-title"><span class="pt-dot working"></span>claude · ~/sudos</div>
                  <div class="pane-body" id="left-body"></div>
                </div>
                <div class="pane" id="pane-codex" data-agent="codex">
                  <div class="pane-title" id="codex-title"><span class="pt-dot done"></span>codex · ~/sudos</div>
                  <div class="pane-body" id="codex-body"></div>
                </div>
              </div>
              <div class="demo-panes" id="ws-webapp" hidden>
                <div class="pane" id="pane-copilot" data-agent="copilot">
                  <div class="pane-title" id="copilot-title"><span class="pt-dot blocked"></span>copilot · ~/webapp</div>
                  <div class="pane-body" id="copilot-body"></div>
                </div>
              </div>
            </div>

            <!-- Agents talking to each other: a job handed down the line with
                 `=name` and reported back to where it started. Four real panes in
                 a 2x2, so it reads as the app rather than a diagram. -->
            <div class="demo-view" id="view-talk" hidden>
              <div class="demo-panes quad">
                <div class="pane focused" id="pane-talk-1">
                  <div class="pane-title" id="talk-1-title"><span class="pt-dot working"></span>claude · ~/sudos</div>
                  <div class="pane-body" id="talk-1"></div>
                </div>
                <div class="pane" id="pane-talk-2">
                  <div class="pane-title" id="talk-2-title"><span class="pt-dot idle"></span>codex · ~/sudos</div>
                  <div class="pane-body" id="talk-2"></div>
                </div>
                <div class="pane" id="pane-talk-3">
                  <div class="pane-title" id="talk-3-title"><span class="pt-dot idle"></span>gemini · ~/sudos</div>
                  <div class="pane-body" id="talk-3"></div>
                </div>
                <div class="pane" id="pane-talk-4">
                  <div class="pane-title" id="talk-4-title"><span class="pt-dot idle"></span>copilot · ~/sudos</div>
                  <div class="pane-body" id="talk-4"></div>
                </div>
              </div>
            </div>

            <div class="demo-view gview" id="view-git" hidden>
              <div class="gtabs">
                <button class="gtab on" data-g="commits">Commits</button>
                <button class="gtab" data-g="flow">Flow</button>
                <button class="gtab" data-g="branches">Branches</button>
                <button class="gtab" data-g="prs">PRs</button>
                <button class="gtab" data-g="issues">Issues</button>
                <button class="gtab" data-g="status">Status</button>
              </div>
              <div class="gbody" id="gbody"></div>
            </div>

            <div class="demo-view gview" id="view-orch" hidden>
              <div class="oheader"><span class="c-acc">◇ orch</span>&nbsp; 4 tasks <span class="sep">·</span> queued 1 <span class="sep">·</span> running 2 <span class="sep">·</span> done 1</div>
              <div class="gbody" id="obody"></div>
              <div class="oleases"><span class="c-acc">LEASES</span>&nbsp; L1 <span class="c-dim">pane 4</span> t2 <span class="c-acc">src/api/**</span> &nbsp; L2 <span class="c-dim">pane 5</span> t3 <span class="c-acc">docs/**</span></div>
            </div>

            <div class="demo-view gview" id="view-ctrl" hidden>
              <div class="oheader">
                <span class="c-acc">Mission Control</span>&nbsp; 3 agents
                <span class="sep">·</span> 1 working <span class="sep">·</span> 1 blocked
                <span class="sep">·</span> <b class="c-acc">$3.99</b> total
              </div>
              <div class="mc">
                <div class="mc-row mc-head">
                  <span>status</span><span>agent</span><span>ctx</span><span>tokens</span>
                  <span>cost</span><span>model</span><span>where</span>
                </div>
                <button class="mc-row" data-jump="claude">
                  <span><i class="dot working"></i>working</span><span>claude</span>
                  <span class="c-acc">28%</span><span>13.2M</span><span>$1.94</span><span>opus</span>
                  <span class="c-dim">sudos · 1</span>
                </button>
                <button class="mc-row" data-jump="copilot">
                  <span><i class="dot blocked"></i>blocked</span><span>copilot</span>
                  <span class="c-warn">86%</span><span>30.2M</span><span>$1.71</span><span>opus</span>
                  <span class="c-dim">webapp · 1</span>
                </button>
                <button class="mc-row" data-jump="codex">
                  <span><i class="dot done"></i>done</span><span>codex</span>
                  <span class="c-acc">54%</span><span>838k</span><span>$0.34</span><span>opus</span>
                  <span class="c-dim">sudos · 1</span>
                </button>
                <div class="mc-bar">
                  <span class="c-dim">cost by model</span>
                  <span class="mcb"><i style="width:88%"></i></span>
                  <span class="c-acc">$3.99</span>
                </div>
              </div>
              <div class="oleases">
                <span class="c-acc">⏎</span> go <span class="sep">·</span>
                <span class="c-acc">a</span> answer <span class="sep">·</span>
                <span class="c-acc">i</span> stop <span class="sep">·</span>
                <span class="c-acc">o</span> details
              </div>
            </div>

            <div class="demo-status">
              <span class="pill">⌃Space</span><span class="dim"> prefix</span>
              <span class="sep">·</span> <span id="status-note">copilot is blocked · click its pane to approve</span>
            </div>
          </div>

          <aside class="demo-right" id="demo-right" data-open="false">
            <button class="rs-toggle" id="rs-toggle" title="Show files" aria-expanded="false">
              <span class="rs-chev">«</span>
            </button>
            <div class="rs-body">
              <div class="side-label rs-head">
                <span>Files</span><span class="c-dim rs-proj">sudos</span>
              </div>
              <div class="ftree">
                <span class="ftr open"><i>▾</i>src</span>
                <span class="ftr in"><i>▾</i>app</span>
                <span class="ftr in2 f"><b class="fg m"></b>mod.rs<em>M</em></span>
                <span class="ftr in2 f"><b class="fg m"></b>input.rs<em>M</em></span>
                <span class="ftr in2 f"><b class="fg a"></b>mission.rs<em>A</em></span>
                <span class="ftr in"><i>▸</i>ui</span>
                <span class="ftr in f"><b class="fg"></b>main.rs</span>
                <span class="ftr open"><i>▾</i>docs</span>
                <span class="ftr in f"><b class="fg"></b>54-mission.md</span>
                <span class="ftr f"><b class="fg"></b>Cargo.toml</span>
                <span class="ftr f"><b class="fg m"></b>README.md<em>M</em></span>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </header>

    <section class="features" id="features">
      <div class="feat-head">
        <span class="eyebrow">What it does</span>
        <h2>Everything your agents need, in one place</h2>
        <p class="feat-sub">A terminal that watches your agents, reads your repo, and ships your code, without another window.</p>
      </div>

      <div class="flist">
        <article class="frow">
          <span class="fr-k">Watch</span>
          <div class="fr-text">
            <h3>Status you can trust</h3>
            <p>Which agents are working, which are blocked on you, which have finished, and where each one lives. An agent only counts as working on positive evidence, so a launching CLI or your own typing never reads as busy.</p>
            <a class="fc-go" href="/docs/guides/agents/">Agent detection →</a>
          </div>
          <div class="fm" aria-hidden="true">
            <div class="fm-head"><span>AGENTS</span><span class="fm-seg"><i>All</i><i class="on">Active</i></span></div>
            <div class="fm-row"><span class="d run"></span>working<b>claude</b><em>sudos · core</em></div>
            <div class="fm-row"><span class="d blk"></span>blocked<b>copilot</b><em>webapp · main</em></div>
            <div class="fm-row"><span class="d done"></span>done<b>codex</b><em>sudos · notes</em></div>
            <div class="fm-row"><span class="d"></span>idle<b>opencode</b><em>api · tab 1</em></div>
          </div>
        </article>

        <article class="frow">
          <span class="fr-k">Supervise</span>
          <div class="fr-text">
            <h3>Cost and context, per project</h3>
            <p>One tab lists every agent in a folder with how full its context window is, what the session has cost, and the project total. Answer a blocked agent inline, or jump to its pane. Token figures come from Claude's own session files today.</p>
            <a class="fc-go" href="/docs/guides/agents/">Mission Control →</a>
          </div>
          <div class="fm" aria-hidden="true">
            <div class="fm-head"><span>⦿ ctrl</span><em>4 agents · 1 blocked · $3.99 total</em></div>
            <div class="fm-row cols"><i class="hd">status</i><i class="hd">agent</i><i class="hd">ctx</i><i class="hd">cost</i><i class="hd">where</i></div>
            <div class="fm-row cols"><span><span class="d run"></span>working</span><b>claude</b><i class="ok">28%</i><em>$1.94</em><em>sudos</em></div>
            <div class="fm-row cols"><span><span class="d blk"></span>blocked</span><b>copilot</b><i class="hot">86%</i><em>$1.71</em><em>webapp</em></div>
            <div class="fm-row cols"><span><span class="d done"></span>done</span><b>codex</b><i class="ok">54%</i><em>$0.34</em><em>sudos</em></div>
            <div class="fm-foot">⏎ go · a answer · i stop · o details</div>
          </div>
        </article>

        <article class="frow">
          <span class="fr-k">Talk</span>
          <div class="fr-text">
            <h3>Agents that hand work to each other</h3>
            <p>Type <code>=</code> and a pane name to delegate the rest of the line. <code>=codex add tests to src/parse.rs</code> sends that instruction to the pane named codex. An agent name or a pane number works just as well. The sender does not wait: it carries on working and picks up the reply when it arrives.</p>
            <a class="fc-go" href="/docs/guides/agent-messaging/">Agent messaging →</a>
          </div>
          <div class="fm bare talk" aria-hidden="true">
