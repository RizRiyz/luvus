         `p` is the pane, `wait` the pause *after* the line lands. Paced to be
         read rather than skimmed, with a long beat at the end before it loops. */
      type TalkStep = { p: 1 | 2 | 3 | 4; html: string; wait: number; dot?: string };
      const M = (n: string) => `<span class="mention">$${n}</span>`;
      const TALK_STEPS: TalkStep[] = [
