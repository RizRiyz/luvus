        .cta-repo::before, .cta-repo::after { animation: none; opacity: 1; }
      }
      section, header.hero {
        max-width: none; margin: 0; padding: 5.5rem var(--gut);
        border-bottom: 1px solid var(--line);
        /* Each section is its own stacking context, so the dot field on the hero
           and the call to action cannot reach past its own section. */
        position: relative; isolation: isolate;
      }
      .accent { color: var(--accent); }
      .dim { color: var(--sub); }
      ::selection { background: var(--sel); color: var(--text); }
      h2 { font-size: 1.45rem; letter-spacing: -0.035em; }
      .feat-sub, .sub, .orch-text p {
        color: var(--sub); font-size: 0.85rem; line-height: 1.8;
      }

      nav {
        background: rgb(from var(--bg) r g b / 0.85);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner {
        display: flex; justify-content: space-between; align-items: center;
        max-width: 1440px; margin: 0 auto; padding: 0.3rem var(--gut);
        /* The bar's height is stated, not inherited from whatever is in it. It
           used to be 34px of mark plus 0.85rem of padding; pinning that means the
           mark and wordmark can be resized without the header growing. */
        min-height: 3.8rem;
      }
      /* The lockup: mark and wordmark share one `color`, so they can never read as
         two different whites. Tight gap so the word sits against the mark rather
         than floating beside it. */
      .brand { display: flex; align-items: center; gap: 0.35rem; font-size: 1.7rem; letter-spacing: -0.05em; color: var(--text); }
      /* Orbit, for the wordmark and nothing else. It ships one 400 weight, so the
         brand is never asked for a bold it does not have; the tight tracking is
         what keeps it from reading as body text at this size. */
      .brand span {
        font-family: 'Orbit', var(--bh-display, ui-monospace), monospace;
        font-weight: 400;
        /* `normal` so the glyph sits centred in a box the face actually asked
           for; the page's 1.75 body leading would otherwise make the wordmark a
           tall item that only looks centred by accident. */
        line-height: normal;
        /* Orbit carries a deep descender, so its *optical* centre sits below the
           box centre that flexbox aligns on: next to the mark the word reads low.
           A transform, not a margin, so nothing reflows and the bar keeps its
           height. Tune with one number. */
        transform: translateY(var(--brand-nudge, -0.06em));
      }
      /* Inline SVG logo mark · crisp at any size, sits flush with the wordmark. */
      .mark { display: block; flex-shrink: 0; }
      /* The nav mark is inline line art. Ink follows the wordmark, so it
         reads as one lockup rather than an image sat beside text. */
      .mark-luvus { width: 42px; height: 42px; }
      .mark-luvus svg { width: 100%; height: 100%; display: block; }
      .nav-links {
        display: flex; align-items: center; gap: 1.4rem; color: var(--sub); font-size: 0.88rem;
        font-family: 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: -0.01em;
      }
      .nav-links a:hover { color: var(--text); }
      .gh {
        display: inline-flex; align-items: center; justify-content: center;
        width: 33px; height: 33px; flex: 0 0 33px; box-sizing: border-box;
        border: 1px solid var(--line); padding: 0;
        transition: border-color 0.15s, color 0.15s;
      }
      .gh:hover { border-color: var(--accent); color: var(--accent); }

      /* Centred, but with the radial green wash gone. The glow and the rounded
         chrome were what made this read as a template, not the alignment. */
      .hero { text-align: left; padding-top: 2.4rem; position: relative; }
      .hero .glow { display: none; }
      /* Copy left, mark right. The mark is decorative, so it yields first when
         the row gets tight. */
      .hero-top {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.52fr);
        gap: 3rem; align-items: center;
      }
      .hero-copy { min-width: 0; }
      .hero h1 {
        font-size: clamp(2.2rem, 5.4vw, 4rem); font-weight: 600; position: relative;
        letter-spacing: -0.05em; line-height: 1.05;
      }
      .hero .sub { color: var(--sub); max-width: 34rem; margin: 1.4rem 0 0; font-size: 1.02rem; line-height: 1.75; }

      /* The mark is drawn as a mask filled with `--text`, so one asset serves
         every palette: light art on the dark themes, dark art on the light
         ones, flipping with the picker and never needing a second file. */
      .hero-art {
        aspect-ratio: 1; width: 100%; max-width: 30rem;
        /* Bottom-aligned, not centred: whichever column is taller, the art's
           lower edge is then the row's lower edge, so the demo below always
           meets it instead of floating a few pixels clear. */
        justify-self: end; align-self: end;
        /* Mirrored so the subject faces the copy rather than the page edge. */
        transform: scaleX(-1);
        /* Between the two extremes: `--text` was a white cut-out (+198 luminance
           over the page) and `--base` vanished (+25). `--overlay1` lands at
           about +68 — clearly legible, still plainly a watermark — and it
           inverts with the palette like the rest. */
        background: var(--overlay1);
        -webkit-mask: var(--art) center / contain no-repeat;
        mask: var(--art) center / contain no-repeat;
      }
      /* The inline Luvus mark uses real SVG rather than a masked image, so the
         knockout fills can sit at `--bg` and read as line art. `color` is the ink,
         the same `--overlay1` the masked mark used, so the weight is comparable.
         Not mirrored: the mark is near-symmetric, so flipping it does nothing. */
      .hero-art-svg {
        background: none; -webkit-mask: none; mask: none;
        transform: none;
        color: var(--overlay1);
        display: flex; align-items: flex-end; justify-content: center;
      }
      /* The mark is a marionette: a control bar up top, two strings, and a
         puppet hanging off them. So it hangs. The pivot is the crossbar rather
         than the middle of the box, which is what makes it read as swinging from
         its strings instead of spinning about its waist.
         Two cycles again, unequal, so the sway and the bob drift against each
         other and it never ticks like a metronome. A couple of degrees is
         plenty; more reads as a pendulum, not a puppet at rest. */
      .hero-art-svg svg {
        width: 100%; height: 100%; display: block;
        transform-origin: 50% 9%;
        animation:
          bh-puppet-sway 6.5s cubic-bezier(0.45, 0, 0.55, 1) infinite,
          bh-puppet-bob 4.3s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      @keyframes bh-puppet-sway {
        0%, 100% { rotate: -2.1deg; }
        50%      { rotate: 2.1deg; }
      }
      @keyframes bh-puppet-bob {
        0%, 100% { translate: 0 0; }
        50%      { translate: 0 1.1%; }
      }
      /* Each ball swings from the point its own string ends, in viewBox units:
         the head off the neck, the two hands off the strings either side. That
         pivot is the whole trick — rotate about a ball's centre and it spins,
         rotate about where it hangs and it dangles.
         Four periods across the mark, none a multiple of another, so the parts
         drift in and out of step and it never settles into a pattern. */
      .hero-art-svg :is(.p-head, .p-left, .p-right) { transform-box: view-box; }
      .hero-art-svg .p-head {
        transform-origin: 500px 407px;
        animation: bh-hang-head 5.1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      .hero-art-svg .p-left {
        transform-origin: 232px 643px;
        animation: bh-hang-left 3.7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      .hero-art-svg .p-right {
        transform-origin: 782px 643px;
        animation: bh-hang-right 4.9s cubic-bezier(0.45, 0, 0.55, 1) infinite;
      }
      /* The hands swing wider than the head: less mass on the end of the string. */
      @keyframes bh-hang-head {
        0%, 100% { rotate: 2.4deg; }
        50%      { rotate: -2.4deg; }
      }
      @keyframes bh-hang-left {
        0%, 100% { rotate: -6deg; }
        50%      { rotate: 5deg; }
      }
      @keyframes bh-hang-right {
        0%, 100% { rotate: 5.5deg; }
        50%      { rotate: -6.5deg; }
      }
      @media (prefers-reduced-motion: reduce) {
        .hero-art-svg svg,
        .hero-art-svg :is(.p-head, .p-left, .p-right) { animation: none; }
      }
