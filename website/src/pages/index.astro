      .mention {
        color: var(--accent); font-weight: 600;
        background: rgb(from var(--accent) r g b / 0.14);
        padding: 0 0.25rem; border-radius: 2px;
      }
      .perm { border: 1px solid rgb(from var(--coral) r g b / 0.35); background: rgb(from var(--coral) r g b / 0.10);  padding: 0.7rem 0.85rem; margin-top: 0.4rem; }
      .perm-q { color: var(--text); margin-bottom: 0.55rem; }
      .perm-btn {
        display: block; width: 100%; text-align: left; background: none; border: 0;
        color: var(--sub); cursor: pointer; padding: 0.2rem 0.4rem;
        font: 0.74rem 'JetBrains Mono Variable', monospace;
      }
      .perm-btn.yes { color: var(--accent); }
      .perm-btn:hover { background: rgb(from var(--coral) r g b / 0.18); }
      .demo-status {
        display: flex; align-items: center; gap: 0.5rem;
        border-top: 1px solid var(--line); padding: 0.42rem 0.8rem;
        color: var(--sub); font-size: 0.7rem; font-family: 'JetBrains Mono Variable', monospace;
      }
      .demo-status .pill { background: var(--accent); color: var(--bg);  padding: 0 0.4rem; font-weight: 700; }
      .demo-status .sep { color: var(--overlay0); }
      @media (max-width: 700px) {
        /* Both sidebars go: on a phone the panes need every column. */
        .demo-side, .demo-right { display: none; }
        .demo-panes { flex-direction: column; }
        .demo-panes.quad { grid-template-columns: 1fr; grid-template-rows: repeat(4, 1fr); }
        /* The Mission Control table drops its least useful columns rather than
           scrolling sideways out of the frame. */
        .mc-row { grid-template-columns: 4.6rem 3.6rem 2.4rem minmax(0, 1fr); }
        .mc-row > :nth-child(n + 5) { display: none; }
      }

      .problem { text-align: center; }
      .beats { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; color: var(--sub); font-size: 0.9rem; }
      .beats .dot { color: var(--accent); }
      .problem > p { color: var(--sub); margin-top: 0.8rem; }
      .problem .turn { color: var(--text); font-size: 1rem; max-width: 40rem; margin: 1.6rem auto 0; }

      .agents-strip h2 { text-align: center; font-size: 1.45rem; margin-bottom: 2rem; }
      /* ── Feature showcase ────────────────────────────────────────────────
         A tab rail plus one stage holding real screenshots of the app. The
         shots are window captures with a black matte baked in, so `.framed`
         scales and offsets them inside an overflow-hidden box to trim it —
         otherwise the page draws a second border around the first one. */
      /* The nav is sticky at top:0 (~3.4rem tall), so an anchored jump would
         drop the heading underneath it. */
      #features { scroll-margin-top: 4.5rem; }
      .feat-head { text-align: center; margin-bottom: 2rem; }
      .eyebrow {
        display: inline-block; font-family: var(--bh-display); font-size: 0.66rem;
        letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent);
        margin-bottom: 0.7rem;
      }
      .features h2 { font-size: 1.45rem; margin-bottom: 0.6rem; letter-spacing: -0.035em; }
      .feat-sub { color: var(--sub); max-width: 42rem; margin: 0 auto; font-size: 0.85rem; line-height: 1.8; }

      /* Feature list: one row per feature, copy left and a mock right — the
         same shape as the orchestration section below. Mocks are built from
         divs rather than screenshots: lighter, always current, and they say
         more per pixel at this size. */
      .flist { display: grid; }
      /* Three columns: the kicker set vertically as a piece of type, the copy,
         then a mock at about two thirds its old width — the mocks read fine
         small, and the extra room goes to the words. */
      .frow {
        display: grid;
        grid-template-columns: 4.4rem minmax(0, 1fr) minmax(0, 0.56fr);
        gap: 0 2.6rem; align-items: center; padding: 2.6rem 0;
      }
      .frow + .frow { border-top: 1px solid var(--line); }
      .frow:first-child { padding-top: 0.6rem; }
      .frow:last-child { padding-bottom: 0.6rem; }

      /* Bottom-to-top: `vertical-rl` runs top-to-bottom, so rotate it. Large
         and tracked out, at low opacity — it reads as a rule down the side of
         the row rather than a label competing with the heading. */
      .fr-k {
        writing-mode: vertical-rl; transform: rotate(180deg);
        justify-self: center; align-self: center;
        font-family: var(--bh-display); font-size: 2.7rem; font-weight: 700;
        letter-spacing: 0.02em; line-height: 1; text-transform: uppercase;
        color: rgb(from var(--accent) r g b / 0.3);
        user-select: none; white-space: nowrap;
      }
      /* Outlined, not filled. Behind `@supports` because the stroke is what
         makes the glyphs visible — without it `color: transparent` would leave
         the word invisible rather than merely unstyled. */
      @supports (-webkit-text-stroke: 1px currentColor) {
        .fr-k {
          color: transparent;
          -webkit-text-stroke: 1px rgb(from var(--accent) r g b / 0.55);
        }
      }
      /* Cap the measure at about two thirds of the column: the leftover becomes
         breathing room before the mock, and 780px of 15px Inter was a ~97
         character line, far past a comfortable read. */
      .fr-text { max-width: 33rem; }
      .fr-text h3 { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.03em; margin: 0 0 0.7rem; }
      .fr-text p { color: var(--sub); font-size: 0.85rem; line-height: 1.85; margin: 0; }
      .fr-text code {
        font-size: 0.92em; color: var(--sub2);
        background: var(--bg2); border: 1px solid var(--line); border-radius: 4px; padding: 0 0.25em;
      }
      .fc-go { display: inline-block; margin-top: 1rem; font-family: var(--bh-display); font-size: 0.72rem; color: var(--accent); }
      .fc-go:hover { text-decoration: underline; }

      /* The mock: a small, honest replica of the real surface. */
      .fm {
        background: var(--bg2); border: 1px solid var(--line);
        font-family: 'JetBrains Mono Variable', monospace; font-size: 0.7rem;
        padding: 0.6rem 0.7rem; display: flex; flex-direction: column; gap: 2px;
        color: var(--sub); overflow: hidden;
      }
      .fm-head {
        display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
        color: var(--overlay1); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase;
        padding-bottom: 0.35rem; margin-bottom: 0.2rem; border-bottom: 1px solid var(--line);
      }
      .fm-head em { font-style: normal; text-transform: none; letter-spacing: 0; color: var(--sub); }
      .fm-seg { display: flex; gap: 2px; text-transform: none; letter-spacing: 0; }
      .fm-seg i { font-style: normal; padding: 0 0.32rem; border-radius: 3px; }
      .fm-seg i.on { background: var(--accent); color: var(--bg); }

      .fm-row { display: flex; align-items: center; gap: 0.45rem; padding: 0.13rem 0.1rem; white-space: nowrap; min-width: 0; }
      .fm-row b { color: var(--text); font-weight: 500; }
      .fm-row em { font-style: normal; color: var(--overlay1); margin-left: auto; }
      .fm-row i { font-style: normal; }
      .fm-row i.ok { color: var(--accent); }
      .fm-row i.hot { color: var(--coral); }
      /* Two panes side by side, framed like the real thing: every pane carries an
         edge, and the divider between them is the seam luvus draws. */
      .fm-panes { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.35rem; }
      .fm-pane { border: 1px solid var(--line); padding: 0.4rem 0.5rem; min-width: 0; }
      .fm-pt {
        display: flex; align-items: center; gap: 0.35rem; color: var(--sub);
        font-size: 0.66rem; letter-spacing: 0.04em; text-transform: uppercase;
        padding-bottom: 0.3rem; margin-bottom: 0.3rem; border-bottom: 1px solid var(--line);
      }
      .fm-ln {
        font-size: 0.68rem; line-height: 1.65; white-space: nowrap;
        overflow: hidden; text-overflow: ellipsis; color: var(--sub);
      }
      .fm-ln i { font-style: normal; color: var(--overlay1); }
      .fm-ln b { color: var(--text); font-weight: 500; }
      .fm-ln.dim { color: var(--overlay1); }
      .fm-ln.ok, .fm-ln.sent, .fm-ln.back { color: var(--mint); }
      .fm-ln.got { color: var(--accent); }
      /* The `=name` token: the one thing on the mock that should catch the eye. */
      .fm-ln u {
        text-decoration: none; color: var(--accent); font-weight: 600;
        background: rgb(from var(--accent) r g b / 0.14); padding: 0 0.2rem;
      }
      /* No outer card on this one: the two panes *are* the mock. A frame around
         framed panes is a box inside a box, and it costs the room the panes want.
         So drop the chrome and let them run to the column's full width. */
      .fm.bare {
        background: none; border: 0; padding: 0;
      }
      .fm.bare .fm-panes { margin-top: 0; gap: 0.6rem; }
      .fm.bare .fm-pane { padding: 0.7rem 0.85rem; }
      .fm.bare .fm-pt { font-size: 0.72rem; padding-bottom: 0.45rem; margin-bottom: 0.45rem; }
      .fm.bare .fm-ln { font-size: 0.78rem; line-height: 1.85; }
      /* Typed on, in the order the exchange actually happens: `--i` on each line
         is its place in the conversation across *both* panes, so the two sides
         interleave instead of each pane filling itself top to bottom.

         `clip-path` rather than `width`, so revealing a line composites instead
         of relaying out the column on every frame. `steps()` gives the characters
         their tick; the caret rides the clip edge. */
      .fm.bare .fm-ln { position: relative; clip-path: inset(0 100% 0 0); }
      .fm.bare.on .fm-ln {
        animation: fm-type 0.62s steps(26, end) forwards;
        animation-delay: calc(var(--i, 0) * 0.5s);
      }
      .fm.bare.on .fm-ln::after {
        content: ''; position: absolute; top: 0.15em; right: -0.1ch;
        width: 0.55ch; height: 1.05em; background: var(--accent);
        opacity: 0; animation: fm-caret 0.62s steps(1) calc(var(--i, 0) * 0.5s);
      }
      @keyframes fm-type { to { clip-path: inset(0 0 0 0); } }
      @keyframes fm-caret { 0%, 99% { opacity: 0.9; } 100% { opacity: 0; } }
      /* Nothing types: every line is simply there. */
      @media (prefers-reduced-motion: reduce) {
        .fm.bare .fm-ln { clip-path: none; }
        .fm.bare.on .fm-ln, .fm.bare.on .fm-ln::after { animation: none; }
        .fm.bare.on .fm-ln::after { display: none; }
      }
      /* Two panes need the width, so they stack rather than shrink. */
      @media (max-width: 900px) {
        .fm-panes { grid-template-columns: 1fr; }
      }
      .fm-row i.hd { color: var(--overlay1); font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.06em; }
      /* The Mission Control table needs real columns, not a flex run. */
      .fm-row.cols {
        display: grid; grid-template-columns: 5.4rem 4.4rem 2.8rem 3.2rem minmax(0, 1fr);
        gap: 0.5rem;
      }
      .fm-row.cols em { margin-left: 0; }
      .fm-row.cols > span { display: flex; align-items: center; gap: 0.35rem; }
      .fm-row.mono b { color: var(--amber); margin-right: 0.15rem; }
      .fm-row.tree.in { padding-left: 0.85rem; }
      .fm-row.tree.in2 { padding-left: 1.6rem; }
      .fm-row.tree i { color: var(--overlay1); width: 0.7rem; }
      .fm-row .g { width: 3px; height: 0.75rem; border-radius: 2px; background: var(--line); flex: none; }
      .fm-row .g.m { background: var(--amber); }
      .fm-row .g.a { background: var(--green); }

      /* Native DIFF mock. Paired rows keep old and new source aligned while
         the colored edge, background, and +/- symbol mirror the three marker
         options in Settings. The note occupies its own row just like the real
         review surface, so it never covers source text. */
      .diff-mock { gap: 0; }
      .diff-mock .fm-head b { font-weight: 600; }
      .fd-add { color: var(--mint); }
      .fd-del { color: var(--coral); }
      .fd-hunk {
        padding: 0.22rem 0.35rem; color: var(--amber);
        background: rgb(from var(--amber) r g b / 0.07);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .fd-labels, .fd-row { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
      .fd-labels {
        color: var(--overlay1); font-size: 0.55rem; letter-spacing: 0.09em;
        padding: 0.24rem 0 0.12rem;
      }
      .fd-labels span { padding-left: 0.35rem; }
      .fd-code {
        display: grid; grid-template-columns: 2.35rem minmax(0, 1fr); gap: 0.25rem;
        min-width: 0; padding: 0.16rem 0.25rem; border-left: 3px solid transparent;
      }
      .fd-code i { font-style: normal; color: var(--overlay1); text-align: right; }
      .fd-code code {
        min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        color: var(--sub2); font: inherit;
      }
      .fd-code.del {
        border-color: var(--coral); background: rgb(from var(--coral) r g b / 0.14);
      }
      .fd-code.add {
        border-color: var(--mint); background: rgb(from var(--mint) r g b / 0.14);
      }
      .fd-code.gap {
        background: repeating-linear-gradient(
          -45deg,
          transparent 0 5px,
          rgb(from var(--line) r g b / 0.42) 5px 6px
        );
      }
      .fd-code.del i { color: var(--coral); }
      .fd-code.add i { color: var(--mint); }
      .fd-note {
        margin: 0.42rem 0.1rem 0.1rem; padding: 0.42rem 0.5rem;
        border: 1px solid rgb(from var(--accent) r g b / 0.7);
        background: rgb(from var(--accent) r g b / 0.07);
      }
      .fd-note > span { display: flex; justify-content: space-between; gap: 0.5rem; }
      .fd-note b { color: var(--accent); font-size: 0.58rem; letter-spacing: 0.06em; }
      .fd-note em { color: var(--overlay1); font-style: normal; font-size: 0.58rem; }
      .fd-note p { margin: 0.25rem 0; color: var(--sub2); line-height: 1.45; }
      .fd-note > i { display: block; color: var(--mint); font-style: normal; text-align: right; }

      /* Luvus Bar mock. The shell protects the three pieces real clients
         protect: tabs on top, prefix help at bottom-left, and the clickable
         version at bottom-right. Module content lives only in the remaining
         space and therefore cannot change pane geometry. */
      .fm.bar-mock { padding: 0; border: 0; background: none; }
      .fb-shell { border: 1px solid var(--line); background: var(--bg2); overflow: hidden; }
      .fb-top {
        display: flex; align-items: center; gap: 0.22rem; min-width: 0;
        padding: 0.3rem 0.38rem; border-bottom: 1px solid var(--line);
      }
      .fb-tab {
        min-width: 0; padding: 0.08rem 0.3rem; color: var(--overlay1);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .fb-tab.on { color: var(--text); border-bottom: 1px solid var(--accent); }
      .fb-tab.add { flex: none; color: var(--accent); }
      .fb-widget {
        display: inline-flex; align-items: center; gap: 0.28rem;
        flex: none; margin-left: auto; padding: 0.1rem 0.34rem;
        color: var(--sub2); border: 1px solid rgb(from var(--mint) r g b / 0.45);
        background: rgb(from var(--mint) r g b / 0.08);
      }
      .fb-widget i { width: 5px; height: 5px; border-radius: 50%; background: var(--mint); }
      .fb-widget b { color: var(--mint); font-weight: 600; }
      .fb-pane {
        min-height: 6.7rem; display: flex; flex-direction: column; justify-content: center;
        gap: 0.34rem; padding: 0.75rem 0.8rem; color: var(--sub2);
      }
      .fb-pane span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .fb-pane i { color: var(--accent); font-style: normal; }
      .fb-pane .dim { color: var(--overlay1); }
      .fb-pane .pass { color: var(--mint); }
      .fb-bottom {
        display: flex; align-items: center; gap: 0.5rem; min-width: 0;
        padding: 0.28rem 0.42rem; border-top: 1px solid var(--line);
        color: var(--overlay1); font-size: 0.59rem;
      }
      .fb-prefix, .fb-version { flex: none; }
      .fb-runtime {
        min-width: 0; margin-left: auto; overflow: hidden;
        text-overflow: ellipsis; white-space: nowrap; color: var(--sub2);
      }
      .fb-version { color: var(--accent); }
      .bar-mock .fm-foot { display: flex; justify-content: flex-end; gap: 0.25rem; }
      .bar-mock .fm-foot b { color: var(--sub2); font-weight: 500; margin-right: auto; }

      .fm .d { width: 6px; height: 6px; border-radius: 50%; flex: none; background: var(--overlay0); }
      .fm .d.run { background: var(--accent); }
      .fm .d.blk { background: var(--coral); }
      .fm .d.done { background: var(--green); }

      .fm-tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0.15rem 0 0.25rem; color: var(--overlay1); }
      .fm-tabs i { font-style: normal; }
      .fm-tabs i.on { color: var(--text); }
      .fm-cmd { color: var(--sub2); padding: 0.2rem 0; }
      /* The compact-mode mock: portrait-ish, with the switcher's two-line,
         finger-sized rows rather than the dense desktop lists. */
      .fm.phone { max-width: 15rem; margin-inline: auto; }
      .fm-tap {
        display: flex; align-items: center; gap: 0.5rem;
        padding: 0.42rem 0.5rem; border-radius: 4px;
        white-space: nowrap; min-width: 0;
      }
      .fm-tap + .fm-tap { border-top: 1px solid var(--line); border-radius: 0; }
      .fm-tap b { color: var(--text); font-weight: 500; }
      .fm-tap em { font-style: normal; color: var(--overlay1); margin-left: auto; font-size: 0.62rem; }
      .fm-tap.dim b { color: var(--sub); }
      /* A replica of the pane context menu (`render_popup` in ui/menu.rs): a
         flat list, one highlighted row, a divider, and the destructive item
         tinted like the app tints it. */
      .fm-menu { display: flex; flex-direction: column; gap: 1px; padding: 0.15rem 0; }
      .mi {
        padding: 0.22rem 0.5rem; border-radius: 4px; color: var(--sub);
        display: flex; align-items: center; white-space: nowrap;
      }
      .mi i { font-style: normal; margin-left: auto; color: var(--overlay1); }
      .mi.on { background: var(--accent); color: var(--bg); font-weight: 500; }
      .mi.danger { color: var(--coral); }
      .mi.sep {
        padding: 0; margin: 0.25rem 0.5rem; height: 1px;
        background: var(--line); border-radius: 0;
      }
      .fm-foot {
        margin-top: 0.3rem; padding-top: 0.35rem; border-top: 1px solid var(--line);
        color: var(--overlay1); font-size: 0.62rem;
      }

      .also { margin-top: 1.6rem; text-align: center; color: var(--sub); font-size: 0.8rem; }
      .also a { color: var(--sub2); text-decoration: underline; text-underline-offset: 3px; }
      .also a:hover { color: var(--accent); }

      @media (max-width: 900px) {
        .hero { text-align: center; }
        .hero-top { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
        .hero .sub { margin-inline: auto; }
        .hero-art { order: -1; justify-self: center; max-width: 15rem; }
        /* Stacked, the demo follows the install lines directly; on desktop the
           hero mark sat between them. */
        .demo { margin-top: 2.2rem; }
        .frow { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; padding: 2rem 0; }
        /* No room for a vertical rule of type on a phone. */
        .fr-k {
          writing-mode: horizontal-tb; transform: none; justify-self: start;
          font-size: 0.68rem; letter-spacing: 0.18em;
          color: var(--accent); -webkit-text-stroke: 0;
        }
        .fr-text h3 { font-size: 1.1rem; }
        /* Columns do not fit a phone; fall back to the flex run. */
        .fm-row.cols { display: flex; }
        .fm-row.cols .hd, .fm-row.cols em + em { display: none; }
      }

      .orch { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: center; }
      .orch h2 { font-size: 1.45rem; margin-bottom: 1rem; }
      .orch p { color: var(--sub); margin-bottom: 1.5rem; }
      .orch p strong { color: var(--text); }

      /* Orchestration board card · clean rows, colored pills, no scroll. */
      .orch-card {
        background: none;
        border: 1px solid var(--line);  overflow: hidden;
        font-family: 'JetBrains Mono Variable', monospace;
      }
      .oc-head {
        display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
        padding: 0.85rem 1.1rem; border-bottom: 1px solid var(--line); background: var(--bg2);
        flex-wrap: wrap;
      }
      .oc-title { color: var(--accent); font-weight: 700; font-size: 0.9rem; letter-spacing: 0.02em; }
      .oc-counts { display: flex; gap: 0.9rem; }
      .ocount { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--sub); font-size: 0.72rem; }
      .d { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
      .d.done { background: var(--mint); }
      .d.run { background: var(--amber); }
      .d.queue { background: var(--overlay0); }
      .oc-rows { padding: 0.5rem 0.6rem; }
      .oc-row {
        display: flex; align-items: center; gap: 0.6rem;
        padding: 0.42rem 0.55rem;  font-size: 0.78rem;
      }
      .oc-row + .oc-row { margin-top: 1px; }
      .oc-row:hover { background: var(--bg2); }
      .oc-row b { color: var(--sub); font-weight: 500; min-width: 1.4rem; }
      .pill {
        font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.05em;
        padding: 0.1rem 0.5rem;  font-weight: 600; flex-shrink: 0;
      }
      .pill.done { color: var(--mint); background: rgb(111 198 163 / 0.13); }
      .pill.run { color: var(--amber); background: rgb(224 154 77 / 0.14); }
      .pill.queue { color: var(--sub); background: var(--surface); }
      .oc-name { color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .oc-meta { margin-left: auto; color: var(--overlay1); font-size: 0.7rem; flex-shrink: 0; }
      .oc-leases {
        display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;
        padding: 0.7rem 1.1rem; border-top: 1px solid var(--line); background: var(--bg2);
      }
      .oc-lk { color: var(--accent); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; }
      .lease { color: var(--sub); font-size: 0.72rem; }
      .lease em { color: var(--accent); font-style: normal; }

      /* "Works with" · a tidy 5-by-2 grid of agent tiles. Each brand mark sits
         on a matching rounded backdrop so the mismatched logos read uniformly. */
      /* Columns sized to their content and the whole grid centred. With seven
         equal `1fr` columns each cell was ~70px wider than the tile inside it,
         and because tiles are left-aligned (so the marks line up) all that slack
         collected on the right. */
      .agent-grid {
        display: grid; grid-template-columns: repeat(7, max-content);
        gap: 0.4rem 1.9rem; justify-content: center; margin: 0;
      }
      /* Left-aligned, with a fixed mark column: centring the row instead put
         every icon at a different x, because the names are different widths. */
      .atile {
        position: relative;
        display: flex; flex-direction: row; align-items: center; justify-content: flex-start;
        gap: 0.6rem; padding: 0.9rem 0.6rem; background: none; border: 0;
      }
      
      .aicon {
        flex: none; width: 34px; height: 34px;
        display: flex; align-items: center; justify-content: center;
        background: none; border: 0;
        font-size: 34px; color: var(--sub2);
        transition: color 0.18s;
      }
      .aicon svg { display: block; width: 1em; height: 1em; }
      /* Raster logo drawn as a mask, so it takes `currentColor` and goes accent
         on hover exactly like the inline SVG marks. */
      .amask {
        display: block; width: 1em; height: 1em; background: currentColor;
        -webkit-mask: var(--m) center / contain no-repeat;
        mask: var(--m) center / contain no-repeat;
      }
      /* Lettermark for agents with no icon file: same size and colour as a
         real mark, so the row stays even. */
      .aletter { font-weight: 600; font-size: 0.72em; line-height: 1; font-family: 'IBM Plex Mono', ui-monospace, monospace; }
      /* Flatten every mark to one light color (Cursor-style), green on hover. */
      .aicon svg path { fill: currentColor; }
      .atile:hover .aicon { color: var(--accent); }
      /* Badge logos = colored square + inner glyph. Hide the square so only the
         glyph shows as a clean monochrome mark. */
      .ic-codex svg path[fill='#fff'],
      .ic-gemini svg path[fill^='url'] { display: none; }
      /* Kiro is a purple badge + a white phantom + black details. Dropping the
         badge and punching the details back out in the page colour is what makes
         the phantom readable; the blanket `fill: currentColor` had merged all
         three into one solid blob. */
      .ic-kiro svg path[fill='#9046FF'] { display: none; }
      .ic-kiro svg path[fill='#000'] { fill: var(--bg); }
      .aname { color: var(--sub); font-size: 0.75rem; text-align: left; letter-spacing: -0.01em; white-space: nowrap; }
      .atile:hover .aname { color: var(--text); }
      /* Marks an agent luvus ships a session hook for. Sits on the mark itself,
         as a badge on its top-right corner — anchored to the tile it drifted out
         past the name and read as belonging to the next tile along. */
      .atile.hook .aicon { position: relative; }
      .atile.hook .aicon::after {
        content: ''; position: absolute; top: -1px; right: -1px;
        width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
        box-shadow: 0 0 0 2px var(--bg);
      }
      @media (max-width: 720px) { .agent-grid { grid-template-columns: repeat(3, max-content); gap: 0.4rem 1.2rem; } }
      @media (max-width: 440px) { .agent-grid { grid-template-columns: repeat(2, max-content); } }
      .agents-strip .note {
        text-align: center; color: var(--sub); margin: 2rem auto 0;
        max-width: 44rem; font-size: 0.82rem; line-height: 1.8;
      }
      .agents-strip .note strong { color: var(--text); font-weight: 600; }
      .agents-strip .note a { color: var(--accent); }
      .hookdot { color: var(--accent); }


      /* ── the name ────────────────────────────────────────────────────── */
      /* The original dictionary + story content now lives in the final GitHub
         card, opposite its artwork, instead of creating a second card. */
      .name-dictionary {
        display: flex; flex-direction: column; justify-content: center;
      }
      .name-entry {
        display: flex; align-items: baseline; gap: 1rem; flex-wrap: wrap;
        line-height: 1;
      }
      .name-word {
        color: var(--text); font-family: 'Orbit', 'IBM Plex Mono', monospace;
        font-size: clamp(2.6rem, 6vw, 5rem); letter-spacing: -0.065em;
      }
      .name-ipa {
        color: var(--sub2); font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        font-size: clamp(1rem, 2vw, 1.35rem); letter-spacing: -0.03em;
      }
      .name-respell {
        margin-top: 1rem; color: var(--sub); font-size: 0.74rem;
        font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
        letter-spacing: 0.04em;
      }
      .name-story {
        display: flex; flex-direction: column; justify-content: center;
        margin-top: 1.35rem; padding-top: 1.35rem;
        border-top: 1px solid var(--line);
      }
      .name-story h2 {
        max-width: 38rem; margin: 0 0 1rem;
        font-size: clamp(1.35rem, 3vw, 2.1rem); line-height: 1.25;
      }
      .name-story p {
        max-width: 43rem; color: var(--sub); font-size: 0.95rem; line-height: 1.85;
      }
      .name-story strong { color: var(--text); font-weight: 600; }

      /* ── closing call to action ──────────────────────────────────────── */
      /* Two columns across the frame: copy left, the mark right. */
      .cta-repo { padding-block: 4rem; }
      .cta-card {
        display: grid; grid-template-columns: minmax(12rem, 0.58fr) minmax(0, 1fr);
        gap: 2rem; align-items: center;
        border: 1px solid var(--line);
        padding: 2.25rem var(--gut);
        overflow: hidden;
      }
      .cta-copy { min-width: 0; }
      .cta-card h2 { font-size: clamp(1.25rem, 2.5vw, 1.7rem); letter-spacing: -0.035em; margin: 0 0 0.65rem; }
      .cta-card p { color: var(--sub); max-width: 40rem; margin: 0; font-size: 0.88rem; line-height: 1.7; }
      .cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.15rem; }
      .cta-actions .btn {
        display: inline-flex; align-items: center; gap: 0.55rem;
        padding: 0.6rem 1.2rem; font-size: 0.86rem;
        transition: border-color 0.15s, filter 0.15s, transform 0.15s;
      }
      .cta-actions .btn:hover { transform: translateY(-2px); }
      .cta-ic { width: 18px; height: 18px; flex-shrink: 0; }

      /* Same canonical, theme-aware SVG as the hero and docs header. */
      .cta-art {
        aspect-ratio: 1; width: min(100%, 19rem);
        justify-self: center; align-self: center;
        color: var(--overlay1);
        overflow: hidden;
      }
      .cta-art svg {
        display: block;
        width: 100%; height: 100%; max-width: 100%;
      }

      @media (max-width: 900px) {
        .cta-card { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; text-align: center; }
        .name-dictionary { align-items: center; }
        .name-entry { justify-content: center; }
        .cta-actions { justify-content: center; }
        .cta-card p { margin-inline: auto; }
        .cta-art { order: -1; width: min(100%, 9rem); }
      }


      footer { border-top: 1px solid var(--line); margin-top: 0; }
      .foot-inner {
        max-width: 1440px; margin: 0 auto; padding: 2rem var(--gut);
        display: flex; justify-content: center; align-items: center; gap: 2.2rem; flex-wrap: wrap;
      }
      .foot-brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
      .foot-brand .dim { font-weight: 400; font-size: 0.85rem; }
      .foot-links { display: flex; gap: 1.3rem; color: var(--sub); font-size: 0.92rem; }
      .foot-links a:hover { color: var(--accent); }

      @media (max-width: 900px) {
        .orch { grid-template-columns: 1fr; }
        section, header.hero { padding: 3rem var(--gut); }
        .agent-grid { grid-template-columns: repeat(4, max-content); gap: 0.4rem 1.4rem; }
      }
      @media (max-width: 480px) {
        .agent-grid { grid-template-columns: repeat(2, max-content); }
        .nav-links a[href$='orchestration/'] { display: none; }
      }

      /* Four nav links + the GitHub pill no longer fit a phone in one row:
         let them wrap rather than widen the page. */
      @media (max-width: 560px) {
        .nav-inner { flex-wrap: wrap; row-gap: 0.45rem; padding-top: 0.7rem; padding-bottom: 0.7rem; }
        .nav-links { gap: 0.9rem; font-size: 0.78rem; flex-wrap: wrap; justify-content: flex-end; }
      }

      /* Brand context menu (right-click the wordmark). Same square, hairline
         language as the theme dock. */
      .brandmenu {
        position: fixed; z-index: 60; min-width: 158px; padding: 0.25rem;
        background: rgb(from var(--bg2) r g b / 0.98);
        border: 1px solid var(--line);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      }
      .brandmenu[hidden] { display: none; }
      .bm-item {
        display: block; width: 100%; padding: 0.3rem 0.6rem;
        background: none; border: 0; text-align: left; cursor: pointer;
        color: var(--sub); font: inherit; font-size: 0.76rem; white-space: nowrap;
      }
      .bm-item:hover, .bm-item:focus-visible {
        background: rgb(from var(--accent) r g b / 0.14); color: var(--text); outline: none;
      }
      .brand { cursor: pointer; }

      /* Theme picker · floating dock, bottom-right, opening upward. Names only:
         descriptions wrapped and forced scrollbars, and the list is short enough
         to show all palettes at once, so there is nothing to scroll. Hovering a
         name previews that palette on the page immediately. */
      .theme-dock { position: fixed; z-index: 40; right: 1.1rem; bottom: 1.1rem; }
      .td-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.42rem 0.7rem; cursor: pointer;
        background: rgb(from var(--bg2) r g b / 0.94);
        border: 1px solid var(--line); color: var(--text);
        font: inherit; font-size: 0.78rem;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        transition: border-color 0.15s;
      }
      .td-btn:hover, .td-btn[aria-expanded='true'] { border-color: var(--accent); }
      .td-caret { color: var(--sub); font-size: 0.6rem; transition: transform 0.18s; }
      .td-btn[aria-expanded='true'] .td-caret { transform: rotate(180deg); }
      .td-sw {
        width: 9px; height: 9px; flex-shrink: 0; display: block;
        background: var(--accent); border: 1px solid rgb(from var(--text) r g b / 0.25);
      }
      /* Grows upward from the button. No max-height and no overflow, so every
         palette is visible and no scrollbar ever appears. */
      .td-list {
        position: absolute; bottom: 100%; right: 0; margin-bottom: -1px;
        margin: 0; padding: 0.3rem; list-style: none;
        background: rgb(from var(--bg2) r g b / 0.98);
        border: 1px solid var(--line);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      }
      .td-list[hidden] { display: none; }
      .td-opt {
        display: flex; align-items: center; gap: 0.6rem; width: 100%;
        padding: 0.26rem 0.75rem 0.26rem 0.5rem; cursor: pointer;
        background: none; border: 0; text-align: left;
        color: var(--sub); font: inherit; font-size: 0.78rem;
        white-space: nowrap;
      }
      .td-opt:hover, .td-opt:focus-visible { background: rgb(from var(--accent) r g b / 0.14); color: var(--text); outline: none; }
      .td-opt[aria-selected='true'] { color: var(--accent); }
    </style>

    <script>
      // Theme picker · palettes come from luvus's own registry, generated into
      // styles/themes.css, so what you preview is what the app ships. Applying a
      // theme sets `data-bh-theme` on <html>, which outranks each page's :root.
      //
      // Hovering a name previews it immediately; the choice is only committed on
      // click, so moving away or closing restores what you had.
      import { DEFAULT_THEME } from '../lib/themes';
      (() => {
        const KEY = 'luvus-theme';
        const dock = document.getElementById('theme-dock');
        const btn = document.getElementById('td-btn');
        const list = document.getElementById('td-list');
        const label = document.getElementById('td-cur');
        if (!dock || !btn || !list || !label) return;
        const opts = [...list.querySelectorAll('.td-opt')];
        const root = document.documentElement;

        let committed = localStorage.getItem(KEY) || DEFAULT_THEME;

        // Preview only: paints the page without touching the committed choice.
        const paint = (id) => root.setAttribute('data-bh-theme', id);

        const commit = (id) => {
          committed = id;
          localStorage.setItem(KEY, id);
          paint(id);
          const o = opts.find((x) => x.dataset.theme === id);
          label.textContent = o ? o.querySelector('.td-name').textContent : id;
          opts.forEach((x) => x.setAttribute('aria-selected', String(x.dataset.theme === id)));
        };

        // Set once the arrow keys take over, so pointer and keyboard previews
        // don't fight over which one wins when the pointer leaves the list.
        let kbdNav = false;

        const open = (yes) => {
          kbdNav = false;
          list.hidden = !yes;
          btn.setAttribute('aria-expanded', String(yes));
          if (yes) (opts.find((o) => o.getAttribute('aria-selected') === 'true') || opts[0])?.focus();
          else paint(committed); // closing always restores the committed palette
        };


        commit(committed);

        btn.addEventListener('click', () => open(list.hidden));
        opts.forEach((o) => {
          // Live preview on hover and on keyboard focus.
          o.addEventListener('mouseenter', () => paint(o.dataset.theme));
          o.addEventListener('focus', () => paint(o.dataset.theme));
          o.addEventListener('click', () => {
            commit(o.dataset.theme);
            open(false);
            btn.focus();
          });
        });
        // Leaving the list without choosing puts the committed palette back —
        // unless the keyboard is driving, in which case the focused row is the
        // preview and the pointer wandering off must not cancel it. Opening the
        // list focuses a row, so testing `activeElement` alone would treat every
        // mouse-opened list as keyboard-driven and leave the preview stuck on
        // whatever was hovered last.
        list.addEventListener('mouseleave', () => {
          if (list.hidden) return;
          const act = document.activeElement;
          const focused = kbdNav && act instanceof HTMLElement ? act.dataset.theme : null;
          paint(focused || committed);
        });
        document.addEventListener('click', (e) => {
          if (!dock.contains(e.target)) open(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !list.hidden) { open(false); btn.focus(); }
        });
        list.addEventListener('keydown', (e) => {
          const i = opts.indexOf(document.activeElement);
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            kbdNav = true;
            const next = e.key === 'ArrowDown' ? i + 1 : i - 1;
            opts[(next + opts.length) % opts.length].focus();
          }
        });
      })();
    </script>

    <script>
      // Right-click the wordmark for the brand assets. Downloads are plain
      // `download` links; the copy reads the built SVG and writes the markup to
      // the clipboard so it can be pasted straight into a design tool.
      (() => {
        const brand = document.querySelector('.brand');
        const menu = document.getElementById('brandmenu');
        const copy = document.getElementById('bm-copy');
        if (!brand || !menu) return;

        const close = () => { menu.hidden = true; };

        brand.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          menu.hidden = false;
          // Place at the cursor, then nudge back inside the viewport.
          const r = menu.getBoundingClientRect();
          const x = Math.min(e.clientX, window.innerWidth - r.width - 8);
          const y = Math.min(e.clientY, window.innerHeight - r.height - 8);
          menu.style.left = `${Math.max(8, x)}px`;
          menu.style.top = `${Math.max(8, y)}px`;
        });

        copy?.addEventListener('click', async () => {
          const label = copy.textContent;
          try {
            const svg = await fetch(copy.dataset.src).then((r) => r.text());
            await navigator.clipboard.writeText(svg);
            copy.textContent = 'Copied';
          } catch {
            copy.textContent = 'Copy failed';
          }
          setTimeout(() => {
            copy.textContent = label;
            close();
          }, 900);
        });

        // Downloads can close immediately; the browser handles the rest.
        menu.querySelectorAll('a.bm-item').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('click', (e) => { if (!menu.contains(e.target)) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        window.addEventListener('blur', close);
      })();
    </script>
  </body>
</html>
