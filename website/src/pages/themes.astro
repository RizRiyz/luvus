---
import jetbrainsLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import plexLatin600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/orbit/400.css';
import '../styles/themes.css';
import { NAV_MARK } from '../lib/mark';
import { THEMES, DEFAULT_THEME } from '../lib/themes';
import { MAKER_THEMES, THEME_FIELDS, THEME_GROUPS, THEME_FILE_VERSION, THEME_MIN_LUVUS } from '../lib/theme-schema';
import XLogo from '../components/XLogo.astro';

const makerStyle = (theme: (typeof MAKER_THEMES)[number]) =>
  THEME_FIELDS.map((field) => `${field.css}:${theme.colors[field.id]}`).join(';');

const title = 'Luvus Theme Maker';
const description = 'Choose a Luvus theme, edit every semantic color, preview the real interface instantly, and export a portable TOML theme.';
const GITHUB = 'https://github.com/RizRiyz/luvus';
const X = 'https://x.com/luvusdev';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://luvus.dev/themes/" />
    <link rel="preload" href={jetbrainsLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexLatin600} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://luvus.dev/themes/" />
    <meta property="og:image" content="https://luvus.dev/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ FALLBACK: DEFAULT_THEME }}>
      try {
        document.documentElement.setAttribute(
          'data-bh-theme',
          localStorage.getItem('luvus-theme') || FALLBACK
        );
      } catch (e) {
        document.documentElement.setAttribute('data-bh-theme', FALLBACK);
      }
    </script>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a class="brand" href="/">
          <span class="mark mark-luvus" aria-hidden="true" set:html={NAV_MARK}></span>
          <span>Luvus</span>
        </a>
        <div class="nav-links">
          <a href="/docs/">Docs</a>
          <a href="/modules/">Modules</a>
          <a href="/themes/" aria-current="page">Themes</a>
          <a href="/blog/">Blog</a>
          <a href="/changelog/">Changelog</a>
          <a href={GITHUB} class="gh" aria-label="Luvus on GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          </a>
          <a href={X} class="gh" aria-label="Luvus on X" title="X"><XLogo /></a>
        </div>
      </div>
    </nav>

    <main>
      <header class="intro">
        <div>
          <p class="eyebrow">Theme maker · live preview</p>
          <h1>Make Luvus <span>yours.</span></h1>
          <p class="lede">Choose a palette, change any semantic color, and watch Luvus repaint immediately. Download it, install it locally, or publish it for community review.</p>
        </div>
        <div class="intro-actions">
          <button type="button" class="button secondary" id="import-btn">Import TOML</button>
          <input type="file" id="import-file" accept=".toml,text/plain" hidden />
          <button type="button" class="button" id="download-btn">Download theme</button>
        </div>
      </header>

      <section class="maker" aria-label="Interactive Luvus theme maker">
        <aside class="editor">
          <div class="editor-head">
            <div>
              <p class="panel-kicker">Start from</p>
              <label class="sr-only" for="preset">Theme preset</label>
              <select id="preset">
                <optgroup label="Theme Maker example">
                  <option value="warm-copper">Warm Copper</option>
                </optgroup>
                <optgroup label="Community themes">
                  {MAKER_THEMES.map((theme) => <option value={theme.id}>{theme.name}</option>)}
                </optgroup>
                <optgroup label="Luvus built-ins">
                  {THEMES.map((theme) => <option value={theme.id}>{theme.label}</option>)}
                </optgroup>
              </select>
            </div>
            <button type="button" class="small-button" id="reset-btn">Reset</button>
          </div>

          <details class="identity">
            <summary>Theme identity</summary>
            <div class="identity-grid">
              <label>Theme ID <input id="theme-id" value="warm-copper" spellcheck="false" /></label>
              <label>Display name <input id="display-name" value="Warm Copper" /></label>
              <label>Description <input id="theme-description" value="A dark brown palette with a restrained copper accent." maxlength="512" /></label>
              <label>Author <input id="theme-author" placeholder="Your GitHub username" maxlength="128" /></label>
              <label>Version <input id="theme-version" value={THEME_FILE_VERSION} maxlength="64" spellcheck="false" /></label>
              <label>Appearance
                <select id="appearance"><option value="dark">Dark</option><option value="light">Light</option></select>
              </label>
            </div>
          </details>

          <div class="color-groups">
            {THEME_GROUPS.map((group) => (
              <fieldset>
                <legend>{group}</legend>
                {THEME_FIELDS.filter((field) => field.group === group).map((field) => (
                  <div class="color-row" data-control={field.id}>
                    <label for={`hex-${field.id}`} title={field.help}>
                      <span class="color-label">{field.label}</span>
                    </label>
                    <div class="color-inputs">
                      <input class="picker" type="color" id={`pick-${field.id}`} data-color={field.id} aria-label={`${field.label} color picker`} />
                      <input class="hex" id={`hex-${field.id}`} data-hex={field.id} inputmode="text" maxlength="7" spellcheck="false" aria-describedby={`help-${field.id}`} />
                    </div>
                    <span class="sr-only" id={`help-${field.id}`}>{field.help}</span>
                  </div>
                ))}
              </fieldset>
            ))}
          </div>
        </aside>

        <div class="stage">
          <div class="stage-head">
            <h2>Live Luvus preview</h2>
            <div class="viewport-switch" role="group" aria-label="Preview size">
              <button type="button" data-size="wide" class="on">Wide</button>
              <button type="button" data-size="compact">Compact</button>
            </div>
          </div>

          <div class="preview-wrap">
            <section class="preview" id="theme-preview" data-size="wide" aria-label="Luvus interface theme preview">
              <div class="app-body">
                <aside class="sidebar" data-token="base">
                  <div class="side-brand" data-token="text accent"><b>◉ luvus</b><span>v0.11</span><button>Menu</button></div>
                  <div class="dock-title" data-token="subtext0">Workspaces</div>
                  <div class="workspace selected" data-token="sel_bg accent text"><span>▾</span> sudos <small>⎇ main</small></div>
                  <div class="workspace" data-token="subtext1"><span>▸</span> webapp <small>⎇ feat/ui</small></div>
                  <div class="dock-title agents-title" data-token="subtext0"><span>Agents</span><small>All&nbsp; <b>Active</b></small></div>
                  <div class="agent focused" data-token="accent text"><i class="state working"></i>claude <small>sudos</small></div>
                  <div class="agent" data-token="text coral"><i class="state blocked"></i>copilot <small>website</small></div>
                  <div class="agent" data-token="text mint"><i class="state done"></i>codex <small>sudos</small></div>
                  <div class="agent" data-token="text green"><i class="state idle"></i>pi <small>docs</small></div>
                </aside>

                <section class="workspace-view" data-token="mantle">
                  <div class="tabs" data-token="surface1">
                    <button class="tab active" data-token="surface0 accent text">1 main</button>
                    <button class="tab" data-token="subtext0">2 ⎇ git</button>
                    <button class="tab" data-token="subtext0">3 ◇ orch</button>
                    <button class="tab" data-token="subtext0">4 ⦿ ctrl</button>
                    <span data-token="overlay0">+</span>
                  </div>

                  <div class="panes">
                    <article class="pane pane-focused" data-token="border_focus mantle">
                      <header data-token="surface0 accent text"><span class="state working"></span> claude · ~/sudos</header>
                      <div class="terminal" data-token="text">
                        <p data-token="subtext0">⏺ Reading <b data-token="accent">src/ui/theme.rs</b>…</p>
                        <p>Every semantic token now updates the preview.</p>
                        <p data-token="green">✓ Parsed 18 theme colors</p>
                        <p data-token="mint">✓ Preview registry synchronized</p>
                        <p data-token="subtext1">The exported TOML uses the same role names.</p>
                        <p class="selection" data-token="sel_bg text">selected text shows the selection background</p>
                        <p data-token="amber">◐ Running contrast checks…</p>
                      </div>
                      <div class="composer" data-token="surface0 border text"><span data-token="accent">❯</span> Adjust the accent color…<i data-token="subtext0">shift+enter newline</i></div>
                    </article>

                    <article class="pane" data-token="border mantle">
                      <header data-token="surface0 text"><span class="state blocked"></span> copilot · ~/website</header>
                      <div class="terminal">
                        <p data-token="subtext0">Permission required</p>
                        <div class="permission" data-token="surface0 border">
                          <strong data-token="text">Publish this theme?</strong>
                          <button data-token="accent sel_bg">❯ 1. Preview only</button>
                          <button data-token="subtext1">&nbsp;&nbsp;2. Cancel</button>
                        </div>
                        <p data-token="coral">● blocked · waiting for approval</p>
                        <p data-token="overlay1">Focused and unfocused borders use separate roles.</p>
                      </div>
                    </article>
                  </div>
                </section>
                <div class="statusbar" data-token="crust surface1 subtext0"><b data-token="accent">⌃Space</b> prefix <span data-token="overlay0">·</span> <span data-token="coral">copilot needs you</span></div>
              </div>

            </section>
          </div>

          <div class="diagnostics">
            <div id="quality" class="quality" role="status" aria-live="polite"></div>
            <div class="export-head">
              <div><p class="panel-kicker">Portable theme file</p><p>Install downloads with <code>luvus theme install ./theme.toml</code>, or publish them to the reviewed community registry. <a href="https://github.com/RizRiyz/luvus/blob/main/community/themes/README.md" target="_blank" rel="noreferrer">Read the contribution guide.</a></p></div>
              <div class="export-actions">
                <button type="button" class="small-button" id="copy-btn">Copy TOML</button>
                <button type="button" class="small-button publish-button" id="publish-btn" title="Open GitHub's fork and pull request flow">Publish theme</button>
              </div>
            </div>
            <textarea id="toml-output" readonly spellcheck="false" aria-label="Generated theme TOML"></textarea>
          </div>
        </div>
      </section>

      <section class="starters" aria-labelledby="starters-title">
        <div class="starters-head">
          <p class="panel-kicker">{MAKER_THEMES.length} reviewed palettes</p>
          <h2 id="starters-title">Community themes</h2>
          <p>Install one directly, or open it in the maker as a complete editable example.</p>
        </div>
        <div class="starter-grid">
          {MAKER_THEMES.map((theme) => (
            <article class="starter-card" style={makerStyle(theme)}>
              <button type="button" class="starter-edit" data-maker-theme={theme.id}>
                <span class="starter-preview" aria-hidden="true">
                  <span class="starter-bar"><i></i><i></i><i></i></span>
                  <span class="starter-body">
                    <span class="starter-side"><b></b><b></b><b></b><i></i></span>
                    <span class="starter-main">
                      <span class="starter-tabs"><b></b><b></b><b></b></span>
                      <span class="starter-panes"><i></i><i></i></span>
                      <span class="starter-lines"><b></b><b></b><b></b></span>
                    </span>
                  </span>
                </span>
                <span class="starter-meta"><strong>{theme.name}</strong><span>Edit palette →</span></span>
              </button>
              <button type="button" class="starter-install" data-install-theme={theme.id} title={`Copy: luvus theme install community/${theme.id}`}>
                <code>luvus theme install community/{theme.id}</code><span>Copy</span>
              </button>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer><span>Built for the terminal. Designed in the browser.</span><a href="/docs/guides/themes/">Theming docs</a></footer>

    <script>
      import { THEMES, DEFAULT_THEME, modeOf } from '../lib/themes';
      import {
        MAKER_THEMES,
        THEME_FIELDS,
        THEME_FILE_VERSION,
        THEME_MIN_LUVUS,
        WARM_COPPER,
      } from '../lib/theme-schema';

      const root = document.documentElement;
      const preview = document.getElementById('theme-preview') as HTMLElement;
      const preset = document.getElementById('preset') as HTMLSelectElement;
      const themeId = document.getElementById('theme-id') as HTMLInputElement;
      const displayName = document.getElementById('display-name') as HTMLInputElement;
      const themeDescription = document.getElementById('theme-description') as HTMLInputElement;
      const themeAuthor = document.getElementById('theme-author') as HTMLInputElement;
      const themeVersion = document.getElementById('theme-version') as HTMLInputElement;
      const appearance = document.getElementById('appearance') as HTMLSelectElement;
      const output = document.getElementById('toml-output') as HTMLTextAreaElement;
      const quality = document.getElementById('quality') as HTMLElement;
      const validHex = /^#[0-9a-f]{6}$/i;
      let draft: Record<string, string> = {};
      let base: Record<string, string> = {};

      const normalize = (value: string) => value.trim().toLowerCase();
      const esc = (value: string) => value.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
      const titleCase = (value: string) => value.split(/[-_.\s]+/).filter(Boolean).map((part) => part[0]?.toUpperCase() + part.slice(1)).join(' ');

      function readBuiltIn(id: string): Record<string, string> {
        const previous = root.getAttribute('data-bh-theme') || DEFAULT_THEME;
        root.setAttribute('data-bh-theme', id);
        const style = getComputedStyle(root);
        const colors = Object.fromEntries(THEME_FIELDS.map((field) => {
          const value = normalize(style.getPropertyValue(field.css));
          return [field.id, validHex.test(value) ? value : WARM_COPPER[field.id]];
        }));
        root.setAttribute('data-bh-theme', previous);
        return colors;
      }

      function setColor(id: string, value: string, render = true) {
        const normalized = normalize(value);
        if (!validHex.test(normalized)) return false;
        draft[id] = normalized;
        const field = THEME_FIELDS.find((entry) => entry.id === id)!;
        preview.style.setProperty(field.css, normalized);
        const picker = document.querySelector<HTMLInputElement>(`[data-color="${id}"]`);
        const hex = document.querySelector<HTMLInputElement>(`[data-hex="${id}"]`);
        if (picker && picker.value !== normalized) picker.value = normalized;
        if (hex && hex.value !== normalized) hex.value = normalized;
        hex?.removeAttribute('aria-invalid');
        if (render) refreshOutput();
        return true;
      }

      function load(values: Record<string, string>, id: string, name: string, mode: string, metadata?: { description?: string; author?: string; version?: string }) {
        base = { ...values };
        draft = {};
        themeId.value = id;
        displayName.value = name;
        themeDescription.value = metadata?.description ?? '';
        themeAuthor.value = metadata?.author ?? '';
        themeVersion.value = metadata?.version ?? THEME_FILE_VERSION;
        appearance.value = mode;
        THEME_FIELDS.forEach((field) => setColor(field.id, values[field.id], false));
        refreshOutput();
      }

      function loadPreset(id: string) {
        if (id === 'warm-copper') {
          load(WARM_COPPER, 'warm-copper', 'Warm Copper', 'dark', { description: 'A dark brown palette with a restrained copper accent.' });
          return;
        }
        const maker = MAKER_THEMES.find((theme) => theme.id === id);
        if (maker) {
          load(maker.colors, maker.id, maker.name, maker.appearance, { description: maker.description, author: 'Luvus' });
          return;
        }
        const found = THEMES.find((theme) => theme.id === id);
        load(readBuiltIn(id), `${id}-custom`, `${found?.label ? titleCase(found.label) : titleCase(id)} Custom`, modeOf(id), { description: found?.note ?? '', author: 'Luvus' });
      }

      function makeToml() {
        const safeId = themeId.value.trim() || 'my-theme';
        const name = displayName.value.trim() || titleCase(safeId);
        const lines = [
          'schema = 1',
          `id = "${esc(safeId)}"`,
          `display_name = "${esc(name)}"`,
          `description = "${esc(themeDescription.value.trim())}"`,
          `author = "${esc(themeAuthor.value.trim())}"`,
          `version = "${esc(themeVersion.value.trim() || THEME_FILE_VERSION)}"`,
          `requires_luvus = ">=${THEME_MIN_LUVUS}"`,
          `appearance = "${appearance.value}"`,
          '',
          '[colors]',
          ...THEME_FIELDS.map((field) => `${field.id} = "${draft[field.id]}"`),
          '',
        ];
        return lines.join('\n');
      }

      function rgb(hex: string) {
        return [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];
      }
      function luminance(hex: string) {
        return rgb(hex).map((channel) => channel / 255).map((channel) => channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4).reduce((sum, channel, index) => sum + channel * [0.2126, 0.7152, 0.0722][index], 0);
      }
      function contrast(a: string, b: string) {
        const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
        return (hi + 0.05) / (lo + 0.05);
      }

      function assess() {
        const warnings: string[] = [];
        if (!/^[a-z0-9][a-z0-9._-]*$/.test(themeId.value.trim())) warnings.push('Theme ID should use lowercase letters, numbers, dots, dashes, or underscores.');
        if (!/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$/.test(themeVersion.value.trim())) warnings.push('Version should be valid semantic versioning, such as 1.0.0.');
        const textRatio = contrast(draft.text, draft.mantle);
        const subRatio = contrast(draft.subtext1, draft.mantle);
        if (textRatio < 4.5) warnings.push(`Primary text contrast is ${textRatio.toFixed(1)}:1; aim for at least 4.5:1.`);
        if (subRatio < 3) warnings.push(`Secondary text contrast is ${subRatio.toFixed(1)}:1; aim for at least 3:1.`);
        const surfaces = ['crust', 'mantle', 'base', 'surface0', 'surface1'].map((id) => draft[id]);
        if (new Set(surfaces).size < surfaces.length) warnings.push('Two main surfaces are identical, so some UI layers may disappear.');
        const states = ['green', 'mint', 'amber', 'coral'].map((id) => draft[id]);
        if (new Set(states).size < states.length) warnings.push('Two agent state colors are identical.');
        quality.classList.toggle('warn', warnings.length > 0);
        quality.innerHTML = warnings.length
          ? `<strong>${warnings.length} suggestion${warnings.length === 1 ? '' : 's'}</strong><ul>${warnings.map((warning) => `<li>${warning}</li>`).join('')}</ul>`
          : `<strong>✓ Palette looks usable</strong><span> Primary text contrast ${textRatio.toFixed(1)}:1 · all 18 roles are present.</span>`;
      }

      function refreshOutput() {
        output.value = makeToml();
        assess();
      }

      function parseToml(text: string) {
        const colorSection = text.split(/^\s*\[colors\]\s*$/m)[1];
        if (!colorSection) throw new Error('Missing [colors] section.');
        const colors: Record<string, string> = {};
        for (const field of THEME_FIELDS) {
          const match = colorSection.match(new RegExp(`^\\s*${field.id}\\s*=\\s*"(#[0-9a-fA-F]{6})"`, 'm'));
          if (!match) throw new Error(`Missing or invalid ${field.id} color.`);
          colors[field.id] = normalize(match[1]);
        }
        const value = (key: string) => text.match(new RegExp(`^\\s*${key}\\s*=\\s*"([^"]*)"`, 'm'))?.[1];
        return {
          colors,
          id: value('id') || 'imported-theme',
          name: value('display_name') || titleCase(value('id') || 'Imported Theme'),
          mode: value('appearance') === 'light' ? 'light' : 'dark',
          description: value('description') || '',
          author: value('author') || '',
          version: value('version') || THEME_FILE_VERSION,
        };
      }

      preset.addEventListener('change', () => loadPreset(preset.value));
      document.querySelectorAll<HTMLButtonElement>('[data-maker-theme]').forEach((card) => card.addEventListener('click', () => {
        const id = card.dataset.makerTheme!;
        preset.value = id;
        loadPreset(id);
        document.querySelector('.maker')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }));
      document.querySelectorAll<HTMLButtonElement>('[data-install-theme]').forEach((button) => button.addEventListener('click', async () => {
        const command = `luvus theme install community/${button.dataset.installTheme}`;
        try {
          await navigator.clipboard.writeText(command);
          const label = button.querySelector('span');
          if (label) {
            label.textContent = 'Copied ✓';
            setTimeout(() => label.textContent = 'Copy', 1200);
          }
        } catch {
          window.prompt('Copy this command:', command);
        }
      }));
      document.querySelectorAll<HTMLInputElement>('[data-color]').forEach((input) => input.addEventListener('input', () => setColor(input.dataset.color!, input.value)));
      document.querySelectorAll<HTMLInputElement>('[data-hex]').forEach((input) => {
        input.addEventListener('input', () => {
          const ok = setColor(input.dataset.hex!, input.value);
          input.setAttribute('aria-invalid', String(!ok));
        });
        input.addEventListener('blur', () => {
          if (!validHex.test(input.value)) input.value = draft[input.dataset.hex!];
          input.removeAttribute('aria-invalid');
        });
        input.addEventListener('focus', () => {
          preview.querySelectorAll('.token-active').forEach((node) => node.classList.remove('token-active'));
          preview.querySelectorAll(`[data-token~="${input.dataset.hex}"]`).forEach((node) => node.classList.add('token-active'));
        });
      });
      document.querySelectorAll<HTMLInputElement>('[data-hex]').forEach((input) => input.addEventListener('focusout', () => preview.querySelectorAll('.token-active').forEach((node) => node.classList.remove('token-active'))));
      [themeId, displayName, themeDescription, themeAuthor, themeVersion, appearance].forEach((input) => input.addEventListener('input', refreshOutput));
      document.getElementById('reset-btn')?.addEventListener('click', () => load(base, themeId.value, displayName.value, appearance.value, {
        description: themeDescription.value,
        author: themeAuthor.value,
        version: themeVersion.value,
      }));
      const sizeButtons = document.querySelectorAll<HTMLButtonElement>('.viewport-switch [data-size]');
      sizeButtons.forEach((button) => button.addEventListener('click', () => {
        preview.dataset.size = button.dataset.size;
        sizeButtons.forEach((item) => item.classList.toggle('on', item === button));
      }));

      async function copyToml() {
        try {
          await navigator.clipboard.writeText(output.value);
          const button = document.getElementById('copy-btn')!;
          button.textContent = 'Copied ✓';
          setTimeout(() => button.textContent = 'Copy TOML', 1200);
