          quality.classList.add('warn');
          quality.innerHTML = `<strong>Add theme details</strong><span> A ${missing[1]} is required for community review.</span>`;
          (missing[0] as HTMLInputElement).focus();
          return;
        }
        const url = new URL('https://github.com/RizRiyz/luvus/new/main');
        url.searchParams.set('filename', `community/themes/${id}.toml`);
        url.searchParams.set('value', makeToml());
