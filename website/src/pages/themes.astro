        const blob = new Blob([output.value], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        const safe = themeId.value.trim().replace(/[^a-zA-Z0-9._-]+/g, '-') || 'luvus-theme';
        link.href = url;
