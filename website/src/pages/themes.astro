          output.select();
          document.execCommand('copy');
        }
      }
      document.getElementById('copy-btn')?.addEventListener('click', copyToml);
      document.getElementById('publish-btn')?.addEventListener('click', () => {
        const id = themeId.value.trim();
        if (!/^[a-z0-9][a-z0-9._-]*$/.test(id)) {
          assess();
          themeId.focus();
          return;
        }
        if (!/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$/.test(themeVersion.value.trim())) {
          assess();
          themeVersion.focus();
          return;
        }
        if (id === 'terminal' || THEMES.some((theme) => theme.id === id)) {
          quality.classList.add('warn');
          quality.innerHTML = '<strong>Choose a unique theme ID</strong><span> Built-in theme IDs are reserved and cannot be published.</span>';
          themeId.focus();
          return;
        }
        if (MAKER_THEMES.some((theme) => theme.id === id)) {
          quality.classList.add('warn');
          quality.innerHTML = '<strong>Choose a unique theme ID</strong><span> This community theme already exists; use a new ID for your variant.</span>';
          themeId.focus();
          return;
        }
        const missing = [
          [themeDescription, 'description'],
          [themeAuthor, 'author'],
        ].find(([input]) => !(input as HTMLInputElement).value.trim());
