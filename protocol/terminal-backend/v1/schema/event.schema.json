{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luvus.dev/protocol/terminal-backend/v1/schema/event.schema.json",
  "type":"object",
  "properties":{
    "event":{"type":"string"},
    "sequence":{"type":"integer","minimum":1},
    "data":{"type":"object"}
  },
  "required":["event","sequence","data"],
  "additionalProperties":false,
  "oneOf":[
    {
      "properties":{
        "event":{"enum":["terminal.created","terminal.moved","terminal.metadata_changed","terminal.output_ready","terminal.exited","terminal.closed"]},
        "data":{
          "properties":{
            "server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},
            "terminal_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
            "pane_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},
            "content_revision":{"type":"integer","minimum":0},
            "workspace":{"type":["integer","null"],"minimum":1},
            "tab":{"type":["integer","null"],"minimum":1},
            "detail":{"type":"object"}
          },
          "required":["server_generation","terminal_id","pane_id","content_revision","workspace","tab","detail"],
          "additionalProperties":false
        }
      }
    },
    {
      "properties":{
        "event":{"const":"terminal.resync_required"},
        "data":{
          "properties":{"reason":{"const":"subscriber_overflow"}},
          "required":["reason"],
          "additionalProperties":false
        }
      }
    }
  ]
}
