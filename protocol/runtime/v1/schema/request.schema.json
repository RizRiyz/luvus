{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luvus.dev/protocol/runtime/v1/schema/request.schema.json",
  "type":"object",
  "properties":{"id":{"type":"string","minLength":1,"maxLength":128},"method":{"type":"string"},"params":{"type":"object"}},
  "required":["id","method","params"],
  "additionalProperties":false,
  "oneOf":[
    {"properties":{"method":{"const":"runtime.capabilities"},"params":{"type":"object","maxProperties":0}}},
    {"properties":{"method":{"const":"session.snapshot"},"params":{"type":"object","maxProperties":0}}},
    {"properties":{"method":{"const":"pane.processes"},"params":{"$ref":"#/$defs/pane"}}},
    {"properties":{"method":{"const":"agent.explain"},"params":{"$ref":"#/$defs/target"}}},
    {"properties":{"method":{"const":"agent.report"},"params":{"$ref":"#/$defs/report"}}},
    {"properties":{"method":{"const":"agent.release"},"params":{"$ref":"#/$defs/release"}}},
    {"properties":{"method":{"const":"agent.wait"},"params":{"$ref":"#/$defs/wait"}}},
    {"properties":{"method":{"const":"events.subscribe"},"params":{"type":"object","maxProperties":0}}}
  ],
  "$defs":{
    "paneId":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},
    "source":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z][A-Za-z0-9._:/-]*$"},
    "agent":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,31}$"},
    "state":{"enum":["idle","working","blocked","done"]},
    "pane":{"type":"object","properties":{"pane":{"$ref":"#/$defs/paneId"}},"required":["pane"],"additionalProperties":false},
    "target":{"type":"object","properties":{"target":{"type":"string","minLength":1,"maxLength":128},"pane":{"$ref":"#/$defs/paneId"}},"minProperties":1,"maxProperties":1,"additionalProperties":false},
    "report":{"type":"object","properties":{"pane":{"$ref":"#/$defs/paneId"},"source":{"$ref":"#/$defs/source"},"agent":{"$ref":"#/$defs/agent"},"status":{"$ref":"#/$defs/state"},"message":{"type":"string","maxLength":4096},"session_id":{"type":"string","maxLength":512},"sequence":{"type":"integer","minimum":0},"ttl_s":{"type":"integer","minimum":1,"maximum":86400}},"required":["pane","source","agent","status"],"additionalProperties":false},
    "release":{"type":"object","properties":{"pane":{"$ref":"#/$defs/paneId"},"source":{"$ref":"#/$defs/source"}},"required":["pane","source"],"additionalProperties":false},
    "wait":{"type":"object","properties":{"pane":{"$ref":"#/$defs/paneId"},"status":{"$ref":"#/$defs/state"},"timeout_s":{"type":"number","minimum":0,"maximum":3600}},"required":["pane","status"],"additionalProperties":false}
  }
}
