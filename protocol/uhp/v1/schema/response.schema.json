{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luvus.dev/protocol/uhp/v1/response.schema.json",
  "title": "Luvus Universal Harness Protocol response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    }
  },
  "oneOf": [ { "required": ["result"] }, { "required": ["error"] } ],
  "allOf": [
    {
      "if": {
        "required": ["result"],
        "properties": { "result": { "required": ["type", "access"], "properties": { "type": { "const": "uhp_capabilities" } } } }
      },
      "then": { "properties": { "result": {
        "required": ["methods"],
        "properties": {
          "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "access": { "$ref": "#/$defs/effectiveAccess" }
        }
      } } }
    },
    {
      "if": {
        "required": ["result"],
        "properties": {
          "result": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "agent_wait" } }
          }
        }
      },
      "then": { "properties": { "result": { "$ref": "#/$defs/agentWaitResult" } } }
    },
    {"if": {"required": ["result"], "properties": {"result": {"required": ["type"], "properties": {"type": {"const": "agent_prompt"}}}}}, "then": {"properties": {"result": {"$ref": "#/$defs/agentPromptResult"}}}},
    {"if": {"required": ["error"], "properties": {"error": {"required": ["code"], "properties": {"code": {"const": "input_not_echoed"}}}}}, "then": {"properties": {"error": {"required": ["data"], "properties": {"data": {"$ref": "#/$defs/agentPromptFailureData"}}}}}},
    {"if": {"required": ["error"], "properties": {"error": {"required": ["code", "data"], "properties": {"code": {"enum": ["input_not_echoed", "agent_not_running", "send_failed"]}, "data": {"required": ["submission"]}}}}}, "then": {"properties": {"error": {"properties": {"data": {"$ref": "#/$defs/agentPromptFailureData"}}}}}}
  ],
  "$defs": {
    "agentPromptResult": {
      "description": "Submission is text identity evidence, distinct from until-wait completion. Legacy results without submission remain valid and are unconfirmed.",
      "type": "object",
      "properties": {
        "type": {
          "const": "agent_prompt"
        },
        "pane": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$"
        },
        "submitted": {
          "type": "boolean"
        },
        "matched": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "idle",
            "working",
            "blocked",
            "done",
            null
          ]
        },
        "baseline_revision": {
          "type": "integer",
          "minimum": 0
        },
        "content_revision": {
          "type": "integer",
          "minimum": 0
        },
        "submission": {
          "enum": [
            "confirmed",
            "unconfirmed"
          ]
        },
        "reason": {
          "type": "null"
        },
        "evidence": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "submission"
            ]
          },
          "then": {
            "required": [
              "type",
              "pane",
              "submitted",
              "matched",
              "status",
              "baseline_revision",
              "content_revision",
              "submission",
              "reason",
              "evidence"
            ]
          }
        },
        {
          "if": {
            "required": [
              "submission"
            ],
            "properties": {
              "submission": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "enum": [
                  "input_echoed",
                  "timeout"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "submission"
            ],
            "properties": {
              "submission": {
                "const": "unconfirmed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "enum": [
                  "queued",
                  "timeout"
                ]
              }
            }
          }
        }
      ]
    },
    "agentPromptFailureData": {"type": "object", "required": ["pane", "submitted", "baseline_revision", "content_revision", "queued", "submission", "reason"], "properties": {"pane": {"type": "string", "pattern": "^[1-9][0-9]{0,9}$"}, "submitted": {"type": "boolean"}, "baseline_revision": {"type": "integer", "minimum": 0}, "content_revision": {"type": "integer", "minimum": 0}, "queued": {"type": "boolean"}, "submission": {"enum": ["failed", "confirmed", "unconfirmed"]}, "reason": {"enum": ["input_not_echoed", "agent_not_running", "send_failed"]}}},

    "effectiveAccess": {
      "description": "Access-only endpoint authority. The owner endpoint omits this field; unknown additive fields remain valid. allowed_methods is a subset of methods enforced by the gateway.",
      "type": "object",
      "required": ["mode", "allowed_methods", "limits"],
      "properties": {
        "mode": { "enum": ["read_only", "control"] },
        "allowed_methods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "limits": {
          "type": "object",
          "required": ["connections", "requests_per_minute"],
          "properties": {
            "connections": { "type": "integer", "minimum": 1 },
            "requests_per_minute": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "agentWaitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "matched", "pane", "status"],
      "properties": {
        "type": { "const": "agent_wait" },
        "matched": { "type": "boolean" },
        "pane": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{0,9}$" },
        "status": { "type": ["string", "null"], "enum": ["idle", "working", "blocked", "done", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "matched": { "const": true } }, "required": ["matched"] },
          "then": {
            "properties": {
              "pane": { "type": "string", "pattern": "^[1-9][0-9]{0,9}$" },
              "status": { "enum": ["idle", "working", "blocked", "done"] }
            }
          }
        }
      ]
    }
  }
}
