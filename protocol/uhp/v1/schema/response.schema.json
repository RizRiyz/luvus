{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luvus.dev/protocol/uhp/v1/response.schema.json",
  "title": "Luvus Universal Harness Protocol response",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    }
  },
  "oneOf": [ { "required": ["result"] }, { "required": ["error"] } ],
  "allOf": [
    {
      "if": {
        "required": ["result"],
        "properties": { "result": { "required": ["type", "access"], "properties": { "type": { "const": "uhp_capabilities" } } } }
      },
      "then": { "properties": { "result": {
        "required": ["methods"],
        "properties": {
          "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "access": { "$ref": "#/$defs/effectiveAccess" }
        }
      } } }
    },
    {
      "if": {
        "required": ["result"],
        "properties": {
          "result": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "agent_wait" } }
          }
        }
      },
      "then": { "properties": { "result": { "$ref": "#/$defs/agentWaitResult" } } }
    }
  ],
  "$defs": {
    "effectiveAccess": {
      "description": "Access-only endpoint authority. The owner endpoint omits this field; unknown additive fields remain valid. allowed_methods is a subset of methods enforced by the gateway.",
      "type": "object",
      "required": ["mode", "allowed_methods", "limits"],
      "properties": {
        "mode": { "enum": ["read_only", "control"] },
        "allowed_methods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "limits": {
          "type": "object",
          "required": ["connections", "requests_per_minute"],
          "properties": {
            "connections": { "type": "integer", "minimum": 1 },
            "requests_per_minute": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "agentWaitResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "matched", "pane", "status"],
      "properties": {
        "type": { "const": "agent_wait" },
        "matched": { "type": "boolean" },
        "pane": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{0,9}$" },
        "status": { "type": ["string", "null"], "enum": ["idle", "working", "blocked", "done", null] }
      },
      "allOf": [
        {
          "if": { "properties": { "matched": { "const": true } }, "required": ["matched"] },
          "then": {
            "properties": {
              "pane": { "type": "string", "pattern": "^[1-9][0-9]{0,9}$" },
              "status": { "enum": ["idle", "working", "blocked", "done"] }
            }
          }
        }
      ]
    }
  }
}
