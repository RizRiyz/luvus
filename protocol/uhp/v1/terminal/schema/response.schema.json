{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luvus.dev/protocol/uhp/v1/schema/terminal/response.schema.json",
  "type":"object",
  "properties":{
    "id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "result":{
      "type":"object",
      "oneOf":[
        {"properties":{"type":{"const":"uhp_capabilities"},"protocol":{"type":"object"},"server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},"session":{"type":"string"},"event_sequence":{"type":"integer","minimum":0},"methods":{"type":"array","items":{"type":"string"},"uniqueItems":true},"method_contracts":{"type":"array"},"limits":{"type":"object"},"terminal":{"type":"object","required":["capabilities","limits"]}},"required":["type","protocol","server_generation","session","event_sequence","methods","method_contracts","limits","terminal"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_inventory"},"server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},"terminals":{"type":"array","maxItems":1024},"truncated":{"type":"boolean"}},"required":["type","server_generation","terminals","truncated"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_validation"},"state":{"enum":["alive","gone","unknown"]}},"required":["type","state"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_processes"},"server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},"terminal_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"pane_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},"root_process":{"type":"object"},"scan":{"enum":["observed","unavailable"]},"executables":{"type":"array","maxItems":256,"items":{"type":"string","maxLength":512},"uniqueItems":true},"arguments_exposed":{"const":false}},"required":["type","server_generation","terminal_id","pane_id","root_process","scan","executables","arguments_exposed"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_capture"},"mode":{"enum":["visible","recent_unwrapped","detection"]},"ansi":{"type":"boolean"},"text":{"type":"string"},"lines":{"type":"integer","minimum":0,"maximum":300},"bytes":{"type":"integer","minimum":0,"maximum":524288},"truncated":{"type":"boolean"},"content_revision":{"type":"integer","minimum":0}},"required":["type","mode","ansi","text","lines","bytes","truncated"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_stream"},"mode":{"enum":["observe","control"]},"server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},"terminal_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"pane_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},"sequence":{"type":"integer","minimum":0},"content_revision":{"type":"integer","minimum":0},"ansi":{"type":"boolean"},"capture_mode":{"enum":["visible","recent_unwrapped"]},"lines":{"type":"integer","minimum":1,"maximum":200},"frame_bytes":{"type":"integer","minimum":1,"maximum":65536},"queue_capacity":{"const":2},"loss_behavior":{"const":"resync_required_then_close"}},"required":["type","mode","server_generation","terminal_id","pane_id","sequence","content_revision","ansi","capture_mode","lines","frame_bytes","queue_capacity","loss_behavior"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_action"},"state":{"const":"succeeded"},"dispatch":{"enum":["queued","executed"]}},"required":["type","state","dispatch"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_created"},"state":{"const":"succeeded"},"dispatch":{"const":"executed"},"server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},"terminal_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"pane_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},"placement":{"type":"object"},"cwd":{"type":"string"},"root_process":{"type":"object"}},"required":["type","state","dispatch","server_generation","terminal_id","pane_id","placement","cwd","root_process"],"additionalProperties":false},
        {"properties":{"type":{"const":"terminal_backend_snapshot"},"server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},"event_sequence":{"type":"integer","minimum":0},"terminals":{"type":"array","maxItems":1024},"truncated":{"type":"boolean"}},"required":["type","server_generation","event_sequence","terminals","truncated"],"additionalProperties":false},
        {"properties":{"type":{"enum":["terminal_backend_change","terminal_backend_output"]},"content_revision":{"type":"integer","minimum":0}},"required":["type","content_revision"],"additionalProperties":false},
        {"properties":{"type":{"const":"subscription_started"},"sequence":{"type":"integer","minimum":0},"queue_capacity":{"type":"integer","minimum":1,"maximum":256},"loss_behavior":{"const":"resync_required_then_close"}},"required":["type","sequence","queue_capacity","loss_behavior"],"additionalProperties":false}
      ]
    },
    "error":{
      "type":"object",
      "properties":{
        "code":{"enum":["invalid_request","invalid_params","forbidden","frame_too_large","incompatible_protocol","unsupported_capability","stale_server","stale_terminal","stale_route","terminal_not_ready","process_mismatch","terminal_gone","capture_too_large","input_too_large","send_failed","create_failed","close_failed","unavailable","limit_exceeded","control_conflict","timeout","internal"]},
        "message":{"type":"string","maxLength":512},
        "dispatch":{"enum":["not_started","rejected"]},
        "metadata":{"type":"object"}
      },
      "required":["code","message"],
      "additionalProperties":false
    }
  },
  "required":["id"],
  "oneOf":[{"required":["result"]},{"required":["error"]}],
  "additionalProperties":false
}
