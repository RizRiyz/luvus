{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luvus.dev/protocol/uhp/v1/schema/terminal/event.schema.json",
  "type":"object",
  "properties":{
    "event":{"type":"string"},
    "sequence":{"type":"integer","minimum":0},
    "data":{"type":"object"}
  },
  "required":["event","sequence","data"],
  "additionalProperties":false,
  "oneOf":[
    {
      "properties":{
        "event":{"const":"terminal.frame"},
        "data":{
          "properties":{
            "server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},
            "terminal_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
            "pane_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},
            "content_revision":{"type":"integer","minimum":0},
            "mode":{"enum":["visible","recent_unwrapped"]},
            "ansi":{"type":"boolean"},
            "text":{"type":"string","maxLength":65536,"$comment":"Consumers must also enforce a 65536-byte UTF-8 limit and verify bytes and lines against the decoded text."},
            "lines":{"type":"integer","minimum":1,"maximum":200},
            "bytes":{"type":"integer","minimum":0,"maximum":65536},
            "truncated":{"type":"boolean"}
          },
          "required":["server_generation","terminal_id","pane_id","content_revision","mode","ansi","text","lines","bytes","truncated"],
          "additionalProperties":false
        }
      }
    },
    {
      "properties":{
        "event":{"enum":["terminal.created","terminal.moved","terminal.metadata_changed","terminal.output_ready","terminal.exited","terminal.closed"]},
        "sequence":{"type":"integer","minimum":1},
        "data":{
          "properties":{
            "server_generation":{"type":"string","pattern":"^[0-9a-f]{32}$"},
            "terminal_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
            "pane_id":{"type":"string","pattern":"^[1-9][0-9]{0,9}$"},
            "content_revision":{"type":"integer","minimum":0},
            "workspace":{"type":["integer","null"],"minimum":1},
            "tab":{"type":["integer","null"],"minimum":1},
            "detail":{"type":"object"}
          },
          "required":["server_generation","terminal_id","pane_id","content_revision","workspace","tab","detail"],
          "additionalProperties":false
        }
      }
    },
    {
      "properties":{
        "event":{"const":"terminal.resync_required"},
        "sequence":{"type":"integer","minimum":1},
        "data":{
          "properties":{"reason":{"const":"subscriber_overflow"}},
          "required":["reason"],
          "additionalProperties":false
        }
      }
    }
  ]
}
